local CurrentRooms = workspace:WaitForChild("CurrentRooms")

local Color = Color3.fromRGB(133, 149, 255)
local FlashColor = Color3.fromRGB(43, 128, 255)

local TWEEN_INFO = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
local connections = {}

local function ApplyColorToLightOrPart(v, useTween)
	if v:IsA("PointLight")
		or v:IsA("SpotLight")
		or v:IsA("SurfaceLight")
		or (v:IsA("BasePart") and v.Material == Enum.Material.Neon) then

		if useTween then
			TweenService:Create(v, TWEEN_INFO, {
				Color = Color
			}):Play()
		else
			v.Color = Color
		end
	end
end

local function FlashModel(model)
	if not model:IsA("Model") then
		return
	end

	if model.Name ~= "LightStand" and model.Name ~= "Chandelier" then
		return
	end

	for _, v in ipairs(model:GetDescendants()) do
		if v:IsA("PointLight")
			or v:IsA("SpotLight")
			or v:IsA("SurfaceLight")
			or (v:IsA("BasePart") and v.Material == Enum.Material.Neon) then

			v.Color = FlashColor

			task.delay(1.5, function()
				if v and v.Parent then
					TweenService:Create(v, TWEEN_INFO, {
						Color = Color
					}):Play()
				end
			end)
		end
	end
end

local function SetupTargetModel(model, useTween)
	if not model:IsA("Model") then
		return
	end

	if model.Name ~= "LightStand" and model.Name ~= "Chandelier" then
		return
	end

	if connections[model] then
		return
	end

	for _, v in ipairs(model:GetDescendants()) do
		ApplyColorToLightOrPart(v, useTween)
	end

	connections[model] = model.DescendantAdded:Connect(function(descendant)
		task.defer(function()
			ApplyColorToLightOrPart(descendant, false)
		end)
	end)
end

for _, v in ipairs(CurrentRooms:GetDescendants()) do
	if v:IsA("Model") then
		SetupTargetModel(v, true)
	end
end

CurrentRooms.DescendantAdded:Connect(function(obj)
	if not coloring then
		return
	end

	if obj:IsA("Model") then
		task.defer(function()
			SetupTargetModel(obj, false)
		end)
	end
end)

