local function setup(window)
	if window:FindFirstChild("HidePrompt") then
		return
	end

	local part = window.PrimaryPart or window:FindFirstChildWhichIsA("BasePart", true)
	if not part then
		return
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "HidePrompt"
	prompt.ActionText = "Hide"
	prompt.ObjectText = "Wardrobe"
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.Parent = part

	prompt.Triggered:Connect(function(player)
		local char = player.Character
		if not char or player ~= plr then return end
		
		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local head = char:FindFirstChild("Head")
		if not hum or not hrp or not head then return end

		-- Đánh dấu đang chơi để tránh spam click
		if prompt:GetAttribute("Playing") then return end
		prompt:SetAttribute("Playing", true)
		prompt.Enabled = false

		local cam = workspace.CurrentCamera
		local cf = window:GetBoundingBox()
		
		local prePos = cf.Position + cf.LookVector * 9.5

		local preGoal = CFrame.lookAt(
			prePos,
			prePos - cf.LookVector
		)

		local targetPos1 = cf.Position
			- cf.LookVector * -7.5

		local targetPos2 = targetPos1
			- Vector3.new(0, 5, 0)

		local goal1 = CFrame.lookAt(
			targetPos1,
			targetPos1 + cf.LookVector
		)

		local goal2 = CFrame.lookAt(
			targetPos2,
			targetPos2 + cf.LookVector
		)

		local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
		local anim = Instance.new("Animation")
		anim.AnimationId = AnimationId

		local track = animator:LoadAnimation(anim)
		track.Priority = Enum.AnimationPriority.Action4

		cam.CameraType = Enum.CameraType.Scriptable

		local yaw = 0
		local pitch = 0

		local function clamp(x, a, b)
			return math.max(a, math.min(b, x))
		end

		-- Bật camera nhìn xung quanh trước khi vào
		local con
		con = RunService.RenderStepped:Connect(function()
			local delta = UserInputService:GetMouseDelta()
			yaw = clamp(yaw - delta.X * 0.2, -MaxLookAngle, MaxLookAngle)
			pitch = clamp(pitch - delta.Y * 0.2, -MaxLookAngle, MaxLookAngle)

			cam.CFrame = head.CFrame
				* CFrame.Angles(0, math.rad(yaw), 0)
				* CFrame.Angles(math.rad(pitch), 0, 0)
		end)

		hrp.Anchored = true
		
		local lock = true
		RunService:BindToRenderStep("PreLock", Enum.RenderPriority.Character.Value + 2, function()
			if lock then
				hrp.CFrame = preGoal
			end
		end)

		hum:ChangeState(Enum.HumanoidStateType.Physics)
		hum.AutoRotate = false

		lock = false
		RunService:UnbindFromRenderStep("PreLock")

		track:Play()		

		local duration1 = 0.35
		local startTime = tick()
		local startCFrame = hrp.CFrame

		while tick() - startTime < duration1 do
			local alpha = math.min(1, (tick() - startTime) / duration1)
			local easedAlpha = alpha * alpha * (3 - 2 * alpha)

			hrp.CFrame = startCFrame:Lerp(goal1, easedAlpha)
			RunService.RenderStepped:Wait()
		end

		hrp.CFrame = goal1

		task.wait(0.3)
		
		char:SetAttribute("Hiding", true)
		
