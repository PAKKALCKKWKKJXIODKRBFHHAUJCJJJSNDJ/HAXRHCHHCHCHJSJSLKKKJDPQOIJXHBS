local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ContentProvider = game:GetService("ContentProvider")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local mainUI = playerGui:WaitForChild("MainUI")

local GUI_URL = "https://raw.githubusercontent.com/lynguyen26031993-design/-u/refs/heads/main/Place_131351567799504_Frame_Jumpscare_Rebound_1786210706.txt"
local GUI_FILE = "uuduuu"

local function LoadGUI()
    if not isfile(GUI_FILE) then
        writefile(GUI_FILE, game:HttpGet(GUI_URL))
    end

    local asset = getcustomasset(GUI_FILE)
    local objects = game:GetObjects(asset)

    if not objects or #objects == 0 then
        return
    end

    for _, object in ipairs(objects) do
        object.Parent = mainUI
    end
end

local rebound = mainUI:FindFirstChild("Jumpscare_Rebound")
if not rebound then
    LoadGUI()
    rebound = mainUI:FindFirstChild("Jumpscare_Rebound")
end

if not rebound then
    return
end

local static = rebound:FindFirstChild("Static")
local reb = rebound:FindFirstChild("reb")
if not static or not reb then
    return
end

local js = reb:FindFirstChild("Js")
local shakeScript = reb:FindFirstChild("Shake")
if not js then
    return
end

-- Force oldSound asset ID onto the sound instance
js.SoundId = "rbxassetid://109582246349306"
task.spawn(function()
    ContentProvider:PreloadAsync({ js })
end)

local mainSound = game.SoundService:FindFirstChild("Main")

local colors = {
    Color3.fromRGB(146, 255, 237),
    Color3.fromRGB(0, 251, 255),
    Color3.fromRGB(0, 123, 255),
    Color3.fromRGB(197, 222, 255),
    Color3.fromRGB(20, 144, 182),
    Color3.fromRGB(255, 255, 255),
    Color3.fromRGB(146, 255, 237)
}

local shakeColors = {
    Color3.fromRGB(160, 206, 255),
    Color3.fromRGB(0, 123, 255),
    Color3.fromRGB(0, 208, 255),
    Color3.fromRGB(120, 174, 255),
    Color3.fromRGB(255, 255, 255),
    Color3.fromRGB(37, 84, 255),
    Color3.fromRGB(133, 255, 237)
}

local function lerp(a, b, t)
    return a + (b - a) * t
end

local function randomDifferent(tbl, previous)
    local value
    repeat
        value = tbl[math.random(1, #tbl)]
    until value ~= previous
    return value
end

local function StartShake()
    local running = true
    if shakeScript then shakeScript.Enabled = false end

    task.spawn(function()
        while running and reb.Parent do
            task.wait(0.06666666666666667)
            if not running then break end

            local currentRotation = reb.Rotation
            local rotation = (math.random(1, 2) == 1 and -currentRotation or (math.random(1, 2) == 1 and currentRotation + math.random(-360, 360) or currentRotation + currentRotation)) + math.random(-360, 360)
            
            rotation = math.clamp(rotation, -180, 180)
            reb.ImageColor3 = shakeColors[math.random(1, #shakeColors)]

            TweenService:Create(reb, TweenInfo.new(0.183), {Size = UDim2.new(0, math.random(150, 450), 0, math.random(75, 150))}):Play()

            task.delay(0.033, function()
                if not running or not reb.Parent then return end
                TweenService:Create(reb, TweenInfo.new(0.053), {Size = UDim2.new(0, math.random(225, 250), 0, math.random(150, 450))}):Play()
            end)

            task.delay(math.random(300, 600) / 600, function()
                if not running or not js.Parent then return end
                js:Play()
                js.Pitch = math.random(50, 125) / 100
                js.TimePosition = 0.25 + math.random() / 10
            end)

            TweenService:Create(reb, TweenInfo.new(0.053, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(math.random(150, 800) / 1000, 0, math.random(150, 800) / 1000, 0),
                Rotation = -rotation
            }):Play()
        end
    end)
    return function() running = false end
end

local function PlayRebound()
    if mainSound then mainSound.Volume = 0 end
    rebound.Visible = true
    static.BackgroundTransparency = 0
    static.ImageTransparency = 1
    reb.Visible = true
    reb.ImageTransparency = 0
    reb.AnchorPoint = Vector2.new(0.5, 0.5)

    js.TimePosition = 0
    js.Pitch = math.random(75, 125) / 100
    js:Play()

    TweenService:Create(static, TweenInfo.new(0.5), {ImageTransparency = 0.8}):Play()
    task.wait()

    local stopShake = StartShake()
    local targetTransparency = 0
    local rotations = {0, -180, 180}
    local images = {"rbxassetid://236777652", "rbxassetid://236543215"}
    local running = true

    task.spawn(function()
        while running and rebound.Parent do
            task.wait()
            static.BackgroundColor3 = colors[math.random(1, #colors)]
            static.ImageTransparency = lerp(static.ImageTransparency, targetTransparency, 0.1)
            static.Rotation = randomDifferent(rotations, static.Rotation)
            static.Image = randomDifferent(images, static.Image)
            if math.random(1, 5) == 1 then targetTransparency = math.random(0, 50) / 100 end
        end
    end)

    task.wait(2)
    stopShake()
    running = false

    -- Wait one frame to ensure shake loop thread halts completely
    task.wait(0.05)

    -- Cancel any active shake tweens overriding size/position
    local cancelDummy = TweenService:Create(reb, TweenInfo.new(0.01), {})
    cancelDummy:Play()
    cancelDummy:Destroy()

    -- Reset to clean Scale baseline
    reb.ScaleType = Enum.ScaleType.Stretch
    reb.Size = UDim2.fromScale(0.35, 0.35)
    reb.Position = UDim2.fromScale(0.5, 0.5)

    js.TimePosition = 0
    js:Play()

    -- Zoom directly to scale (1.3, 1.3) centered
    local zoomTween = TweenService:Create(reb, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.fromScale(1.3, 1.3),
        Position = UDim2.fromScale(0.5, 0.5),
        Rotation = math.random(-15, 15),
        ImageColor3 = Color3.fromRGB(255, 0, 0)
    })
    zoomTween:Play()
    
    task.wait(1.8)
    
    local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

humanoid.Health = 0

    TweenService:Create(reb, TweenInfo.new(1.2), {ImageTransparency = 1}):Play()
    TweenService:Create(rebound, TweenInfo.new(1), {BackgroundTransparency = 1}):Play()
    TweenService:Create(static, TweenInfo.new(1), {BackgroundTransparency = 1, ImageTransparency = 1}):Play()

    task.delay(1.5, function()
        if mainSound then mainSound.Volume = 0.5 end
        
        -- CLEANUP
        if rebound then rebound:Destroy() end
        script:Destroy()
    end)
end

PlayRebound()
