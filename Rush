local function LoadModel(file, url)
	if not isfile(file) then
		writefile(file, game:HttpGet(url))
	end

	return game:GetObjects(getcustomasset(file))[1]
end

local FaceModel = LoadModel(
	"jcjhshhhs.txt",
	"https://raw.githubusercontent.com/lynguyen26031993-design/-u/refs/heads/main/DARUSHFACEE.txt"
)

local function setupUI()
	local playerGui = LocalPlayer:WaitForChild("PlayerGui", 5)
	if not playerGui then
		return
	end

	local mainUI = playerGui:FindFirstChild("MainUI")
	if not mainUI then
		return
	end

	local jumpscareRush = mainUI:FindFirstChild("Jumpscare") and mainUI.Jumpscare:FindFirstChild("Jumpscare_Rush")
	if jumpscareRush then
local Players = game:GetService("Players")

local active = false

local plr = Players.LocalPlayer
local jumpscare = plr:WaitForChild("PlayerGui")
	:WaitForChild("MainUI")
	:WaitForChild("Jumpscare")
	:WaitForChild("Jumpscare_Rush")
	local imageBig = jumpscare:WaitForChild("ImageLabelBig")

local image = jumpscare:WaitForChild("ImageLabel")
image.Image = "rbxassetid://15518965649"
image.Visible =false

local ids = {
	16444302226,
	16444310736,
	16444316349,
	16447907727
}

local images = {}

for _, id in ipairs(ids) do
	local clone = image:Clone()
	clone.Image = "rbxassetid://" .. id
	clone.Visible = false
	clone.Parent = jumpscare
	table.insert(images, clone)
end

for _, img in ipairs(images) do
	img.Size = UDim2.new(
		img.Size.X.Scale * 1.3,
		math.floor(img.Size.X.Offset * 1.3),
		img.Size.Y.Scale * 1.3,
		math.floor(img.Size.Y.Offset * 1.3)
	)
end

local ghosts = {}

for _, img in ipairs(images) do
	local ghost = img:Clone()
	ghost.Visible = false
	ghost.ImageTransparency = 0.6
	ghost.ZIndex = img.ZIndex - 1
	ghost.Size = UDim2.new(
		img.Size.X.Scale * 1.3,
		math.floor(img.Size.X.Offset * 1.3),
		img.Size.Y.Scale * 1.3,
		math.floor(img.Size.Y.Offset * 1.3)
	)
	ghost.Parent = jumpscare

	ghosts[img] = ghost
end

local singles = images

local shaking = {}

local function stopShake()
	shaking = {}

	for _, img in ipairs(images) do
		img.Visible = false
		img.Rotation = 0
		img.Position = UDim2.new(0.5, 0, 0.5, 0)
		img.AnchorPoint = Vector2.new(0.5, 0.5)
	end
end

local function shake(img)
	local basePos = img.Position

	task.spawn(function()
		while shaking[img] do
			img.Rotation = math.random(-8, 8)
			img.Position = basePos + UDim2.fromOffset(math.random(-4, 4), math.random(-4, 4))
			task.wait(0.02)
		end

		img.Rotation = 0
		img.Position = basePos
	end)
end

local function showSingle(img)
	stopShake()

	img.Visible = true
	shaking[img] = true

	shake(img)
end

task.spawn(function()
	while jumpscare.Parent do
		if active then
			showSingle(singles[math.random(1, #singles)])
			task.wait(math.random(5, 100) / 100)
		else
			task.wait()
		end
	end
end)

task.spawn(function()
	while jumpscare.Parent do
		if active then
			task.wait(0.3)

			local current = {}

			for img in pairs(shaking) do
				table.insert(current, img)
			end

			if #current > 0 then
				local choices = {}

				for _, img in ipairs(images) do
					local ok = true

					for _, cur in ipairs(current) do
						if img == cur then
							ok = false
							break
						end
					end

					if ok then
						table.insert(choices, img)
					end
				end

				if #choices > 0 then
					local source = choices[math.random(#choices)]
					local ghost = ghosts[source]

					ghost.Position = source.Position
					ghost.Rotation = 0
					ghost.Visible = true

					local basePos = ghost.Position
					local alive = true

					task.spawn(function()
						while alive do
							ghost.Rotation = math.random(-8, 8)
							ghost.Position = basePos + UDim2.fromOffset(math.random(-4, 4), math.random(-4, 4))
							task.wait(0.02)
						end

						ghost.Rotation = 0
						ghost.Position = basePos
					end)

					task.wait(0.5)

					alive = false
					ghost.Visible = false
				end
			end
		else
			task.wait()
		end
	end
end)

local function update()
	active = jumpscare.Visible

	if not active then
		stopShake()

		for _, ghost in pairs(ghosts) do
			ghost.Visible = false
		end
	end
end

update()

jumpscare:GetPropertyChangedSignal("Visible"):Connect(update)

local function onImageBig()
	if imageBig.Visible then
		imageBig.Image = "rbxassetid://16444316349"

		for _, img in ipairs(images) do
	img:Destroy()
end

for _, ghost in pairs(ghosts) do
	ghost:Destroy()
end

table.clear(images)
table.clear(ghosts)

		shaking = {}
		active = false
	else
		active = jumpscare.Visible
	end
end

imageBig:GetPropertyChangedSignal("Visible"):Connect(onImageBig)
	end
end

local function processEntity(child)
	task.spawn(function()
		if child.Name ~= "RushMoving" then
			return
		end

		local rushNew = child:WaitForChild("RushNew", 3)
		if not rushNew then
			return
		end

		for _, obj in ipairs(rushNew:GetDescendants()) do
			if obj:IsA("ParticleEmitter") then
				obj.Enabled = false
			elseif obj:IsA("Sound") then
				obj.PlaybackSpeed = 0.19
			end
		end

		if FaceModel then
			local clone = FaceModel:Clone()
			clone.Parent = rushNew
		end
	end)
end

setupUI()

for _, child in ipairs(Workspace:GetChildren()) do
	processEntity(child)
end

Workspace.ChildAdded:Connect(processEntity)
