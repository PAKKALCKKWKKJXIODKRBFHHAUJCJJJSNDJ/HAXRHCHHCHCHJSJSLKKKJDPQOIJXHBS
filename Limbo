	end

	local HasWindow = false

	for _, obj in ipairs(room:GetDescendants()) do
		if obj:IsA("Model") then
			if obj.Name == "Windows"
				or obj.Name == "Window"
				or obj.Name == "Window_Tall" then
				HasWindow = true
				break
			end
		end
	end

	if not HasWindow then
		return true
	end

	return not IsInStormRange(hrp)
end

