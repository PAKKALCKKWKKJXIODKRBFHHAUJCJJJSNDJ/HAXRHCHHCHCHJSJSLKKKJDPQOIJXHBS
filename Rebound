    tween:Play()

    -- 4. Vòng lặp đổi ảnh chạy đồng thời với Tween
    while os.clock() - start < duration do
        if not imageLabel or not imageLabel.Parent then break end
        imageLabel.Image = jumpscareImages[imageIndex]
        imageIndex = (imageIndex % #jumpscareImages) + 1
        task.wait(0.04) -- Tốc độ chớp ảnh ổn định hơn
    end

    -- 5. Đợi Tween hoàn thành hẳn rồi dọn dẹp GUI
