					local tween3 = TweenService:Create(
						textLabel,
						TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
						{
							Position = UDim2.new(0.5, 0, -0.3, 0)
						}
					)
					tween3:Play()
					tween3.Completed:Wait()

					effectScreenGui:Destroy()
				end

				print("work: " .. charmName)
			end)
		end
	end
end

