local FollowSpeed = 23
local StopDistance = 13
local MoveCooldown = 0.8

local Cooldown = false
local CooldownEnd = 0
local Destroyed = false

local FollowConnection

-- Sau khi chờ 3 giây, entity hoạt động thêm 30 giây
task.delay(30, function()
	if Destroyed then return end

	Destroyed = true

	if FollowConnection then
		FollowConnection:Disconnect()
		FollowConnection = nil
	end

	if _Idx57 then
		_Idx57:Destroy()
	end
end)

-- Follow LocalPlayer
FollowConnection = RunService.Heartbeat:Connect(function(dt)
	if Destroyed or not _Idx57.Parent then
		return
	end

	local Char = LP.Character
	local HRP = Char and Char:FindFirstChild("HumanoidRootPart")
	if not HRP then return end

	local Pivot = _Idx57:GetPivot()
	local Pos = Pivot.Position
	local Target = HRP.Position

	local Offset = Target - Pos
	local Distance = Offset.Magnitude

	-- Đang cooldown
	if Cooldown then
		-- Nếu player chạy cách hơn 8 studs thì bỏ cooldown ngay
		if Distance > 8 then
			Cooldown = false

		-- Chưa hết cooldown thì đứng im
		elseif os.clock() < CooldownEnd then
			return

		-- Cooldown hết
		else
			Cooldown = false
		end
	end

	-- Di chuyển khi player cách xa StopDistance
	if Distance > StopDistance then
		local Direction = Offset.Unit
		local Move = math.min(
			FollowSpeed * dt,
			Distance - StopDistance
		)

		local NewPos = Pos + Direction * Move

		_Idx57:PivotTo(
			CFrame.lookAt(NewPos, Target)
		)

		local NewDistance = (Target - NewPos).Magnitude

		-- Entity vừa tới khoảng dừng
		if NewDistance <= StopDistance then
			Cooldown = true
			CooldownEnd = os.clock() + MoveCooldown
		end
	end
end)

