local function GetSyncedRoll(saltString)
    local hash = 5381
    local str = tostring(saltString)
    for i = 1, #str do
        hash = (bit32.lshift(hash, 5) + hash) + string.byte(str, i)
        hash = bit32.band(hash, 0x7FFFFFFF)
    end
    return (hash % 100) + 1
end

