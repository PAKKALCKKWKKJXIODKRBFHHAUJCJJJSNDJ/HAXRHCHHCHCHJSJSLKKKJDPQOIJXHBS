local function setupSound(sound)
    if not sound:IsA("Sound") then return end

    if sound.Name == "SeekMusic" then
        sound.SoundId = SEEK_REPLACEMENT_ID
        sound.Volume = 2.2
        sound:GetPropertyChangedSignal("SoundId"):Connect(function()
            if sound.SoundId ~= SEEK_REPLACEMENT_ID then
                sound.SoundId = SEEK_REPLACEMENT_ID
            end
        end)
    end
end

for _, descendant in ipairs(workspace:GetDescendants()) do
    setupSound(descendant)
end

workspace.DescendantAdded:Connect(function(descendant)
    setupSound(descendant)
end)
