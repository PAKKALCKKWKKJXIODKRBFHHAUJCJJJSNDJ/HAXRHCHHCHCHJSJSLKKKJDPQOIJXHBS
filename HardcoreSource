-- 1. THUẬT TOÁN HASH ĐỒNG BỘ ĐỘC LẬP (DJB2 Hash Engine)
local function GetSyncedRoll(saltString)
    local hash = 5381
    local str = tostring(saltString)
    for i = 1, #str do
        hash = (bit32.lshift(hash, 5) + hash) + string.byte(str, i)
        hash = bit32.band(hash, 0x7FFFFFFF)
    end
    return (hash % 100) + 1
end

-- 2. HÀM TẢI VÀ THỰC THI VỚI FILE CACHE VĨNH VIỄN (WRITEFILE / ISFILE / READFILE)
local function SafeLoadFileCached(url)
    task.spawn(function()
        pcall(function()
            -- Tạo tên file an toàn từ URL (chuyển các ký tự đặc biệt thành dấu gạch dưới)
            local fileName = CACHE_FOLDER .. "/" .. url:gsub("[^%w]", "_") .. ".lua"
            local code = nil
            
            -- Kiểm tra xem file cache đã tồn tại từ trước (hoặc từ phiên chơi trước) chưa
            if isfile and isfile(fileName) then
                local success, result = pcall(readfile, fileName)
                if success and result and result ~= "" then
                    code = result
                end
            end
            
            -- Nếu chưa có file cache (hoặc đọc lỗi), tiến hành tải từ GitHub và lưu vào ổ cứng
            if not code then
                local success, result = pcall(function()
                    return game:HttpGet(url)
                end)
                if success and result and result ~= "" then
                    code = result
                    if writefile then
                        pcall(writefile, fileName, code)
                    end
                end
            end
            
            -- Thực thi mã nguồn
            if code then
                local func, err = loadstring(code)
                if func then
                    func()
                end
            end
        end)
    end)
end

