				obj.Enabled = false
			end
			if not processedObjects[obj] then
				processedObjects[obj] = true
				obj:GetPropertyChangedSignal("Enabled"):Connect(function()
					if obj.Enabled then
						obj.Enabled = false
					end
				end)
