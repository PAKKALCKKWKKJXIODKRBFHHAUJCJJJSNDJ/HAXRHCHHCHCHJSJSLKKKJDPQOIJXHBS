for _, entity in ipairs(RoomEntities) do
	task.spawn(function()
		local lastEvaluatedRoom = tonumber(LatestRoom.Value) or 1
		local lastTrigger = tick()

		local function ProcessRoomCheck()
			local currentRoom = tonumber(LatestRoom.Value) or 1

			if currentRoom == lastEvaluatedRoom then
				return
			end

			lastEvaluatedRoom = currentRoom

			if tick() - lastTrigger < entity.Interval then
				return
			end

			lastTrigger = tick()

			local roll = GetSyncedRoll(entity.Name .. "_Room_" .. currentRoom)
			if roll <= entity.Chance then
				SafeLoadFileCached(entity.Url)
			end
		end

		LatestRoom.Changed:Connect(ProcessRoomCheck)
	end)
end

