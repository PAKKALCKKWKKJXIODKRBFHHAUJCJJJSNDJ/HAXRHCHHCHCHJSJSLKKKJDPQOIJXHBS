end

local function ApplyAnimationToButton(btn)
	local size = btn.Size
	local big = UDim2.new(
		size.X.Scale * CONFIG.Animation.ScaleMultiplier, size.X.Offset,
		size.Y.Scale * CONFIG.Animation.ScaleMultiplier, size.Y.Offset
	)
	local info = TweenInfo.new(CONFIG.Animation.TweenDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)  

	btn.MouseButton1Down:Connect(function()  
		TweenService:Create(btn, info, { Size = big }):Play()  
	end)  

	local function Reset()  
		TweenService:Create(btn, info, { Size = size }):Play()  
	end  

	btn.MouseButton1Up:Connect(Reset)  
	btn.MouseLeave:Connect(Reset)
end

local function SetupTextPopAnimation(lbl, delayTime)
	if not lbl then return function() end end
	local pos = lbl.Position
	local busy = false

	local function Play()  
		if busy then return end  
		busy = true  

		task.delay(delayTime or 0, function()  
			lbl.Position = pos + UDim2.new(0, 0, 0, CONFIG.Animation.TextPopOffset)  
			TweenService:Create(  
				lbl,  
				TweenInfo.new(CONFIG.Animation.TextPopDuration, Enum.EasingStyle.Back, Enum.EasingDirection.Out),  
				{ Position = pos }  
			):Play()  
			task.wait(CONFIG.Animation.TextPopDuration)  
			busy = false  
		end)  
	end  

	lbl:GetPropertyChangedSignal("Text"):Connect(Play)  
	return Play
end

