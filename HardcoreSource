local function UpdateCharmInfo(charmName, data)
	SharedState.CurrentSelectedCharm = charmName
	local charmConfig = CONFIG.Charms[charmName]

	if SharedState.DownsidesLabel then
		SharedState.DownsidesLabel.RichText = true
		SharedState.DownsidesLabel.Text = data.Downsides
	end

	if SharedState.UpsidesLabel then
		SharedState.UpsidesLabel.RichText = true
		SharedState.UpsidesLabel.Text = data.Upsides
	end

	if SharedState.ApplyButton and SharedState.AppliedButton then
		if charmConfig then
			local isUnlocked = isfile(charmConfig.UnlockFile) or charmConfig.TestMode == true
			local isApplied = false

			for _, cfg in pairs(CONFIG.Charms) do
				if cfg.GetGenVar and getgenv()[cfg.GetGenVar] then
					isApplied = (cfg == charmConfig)
					break
				end
			end

			if not isUnlocked then
				SharedState.ApplyButton.Visible = false
				SharedState.AppliedButton.Visible = false
				if SharedState.UnlockLabel then SharedState.UnlockLabel.Visible = true end
			elseif isApplied then
				SharedState.ApplyButton.Visible = false
				SharedState.AppliedButton.Visible = true
				if SharedState.UnlockLabel then SharedState.UnlockLabel.Visible = false end
			else
				SharedState.ApplyButton.Visible = true
				SharedState.AppliedButton.Visible = false
				if SharedState.UnlockLabel then SharedState.UnlockLabel.Visible = false end
			end
		else
			SharedState.ApplyButton.Visible = false
			SharedState.AppliedButton.Visible = false
			if SharedState.UnlockLabel then SharedState.UnlockLabel.Visible = false end
		end
	end

	if SharedState.ImageObj and SharedState.ImageObj:IsA("ImageLabel") then
		if data.Image ~= "" then
			SharedState.ImageObj.Image = data.Image
		else
			SharedState.ImageObj.Image = ""
		end
	end

	if SharedState.DescLabel then
		SharedState.DescLabel.Text = data.Desc
	end

	if SharedState.TaglineLabel then
		SharedState.TaglineLabel.Text = data.Tagline
	end

	if SharedState.TitleLabel then
		SharedState.TitleLabel.Text = data.Title
	end

	if SharedState.UnlockLabel then
		SharedState.UnlockLabel.Text = data.Unlock
	end
end

local function SetupButtonInteractions()
	if not SharedState.ApplyButton or not SharedState.AppliedButton then return end

	if not SharedState.ApplyButton:GetAttribute("Connected") then
		SharedState.ApplyButton:SetAttribute("Connected", true)

		SharedState.ApplyButton.MouseButton1Click:Connect(function()
			local currentName = SharedState.CurrentSelectedCharm
			if not currentName then
				return
			end

			local charmConfig = CONFIG.Charms[currentName]
			if not charmConfig or not (isfile(charmConfig.UnlockFile) or charmConfig.TestMode == true) then
				return
			end

			-- Unapply tất cả charm đang bật
			for _, cfg in pairs(CONFIG.Charms) do
				if cfg.GetGenVar then
					getgenv()[cfg.GetGenVar] = false
				end
			end

			-- Apply charm mới
			if charmConfig.GetGenVar then
				getgenv()[charmConfig.GetGenVar] = true
			end

			SharedState.ApplyButton.Visible = false
			SharedState.AppliedButton.Visible = true

			if SharedState.UnlockLabel then
				SharedState.UnlockLabel.Visible = false
			end

			RefreshCharmListUI()
		end)

		SharedState.AppliedButton.MouseButton1Click:Connect(function()
			local currentName = SharedState.CurrentSelectedCharm
			if not currentName then return end
			local charmConfig = CONFIG.Charms[currentName]
			if not charmConfig then return end

			if charmConfig.GetGenVar then
				getgenv()[charmConfig.GetGenVar] = false
			end

			SharedState.AppliedButton.Visible = false
			SharedState.ApplyButton.Visible = true

			RefreshCharmListUI()
		end)
	end
end

RefreshCharmListUI = function()
	if not SharedState.ListFolder then return end

	for _, v in ipairs(SharedState.ListFolder:GetChildren()) do
		if v:IsA("ImageButton") then
			local charmConfig = CONFIG.Charms[v.Name]
			if charmConfig then
				local unlocked = isfile(charmConfig.UnlockFile) or charmConfig.TestMode == true
				local isApplied = charmConfig.GetGenVar and getgenv()[charmConfig.GetGenVar] == true

				local icons = v:FindFirstChild("Icons")
				if icons then
					local star = icons:FindFirstChild("Star")
					local question = icons:FindFirstChild("Question")
					local upcoming = icons:FindFirstChild("Upcoming")

					if charmConfig.IsTBA then
						if star then star.Visible = false end
						if question then question.Visible = false end
						if upcoming then upcoming.Visible = false end
					elseif charmConfig.IsUpcoming then
						if star then star.Visible = false end
						if question then question.Visible = false end
					elseif unlocked then
						-- Chỉ hiện Star nếu charm này đang được apply, hết apply thì Star tự ẩn
						if star and star:IsA("ImageLabel") then
							star.Visible = isApplied
						end
						if question then question.Visible = false end
						if upcoming then upcoming.Visible = false end
					else
						if star then star.Visible = false end
						if question then question.Visible = true end
						if upcoming then upcoming.Visible = false end
					end
				end
			end
		end
	end
end

local function InitializeCharmList()
	if not SharedState.ListFolder then return end

	local unlockOrder = 0
	local upcomingOrder = 1000
	local tbaOrder = 2000
	local lockOrder = 3000

	for _, v in ipairs(SharedState.ListFolder:GetChildren()) do
		if v:IsA("ImageButton") then

			local charmConfig = CONFIG.Charms[v.Name]
			local shouldShow = false

			if charmConfig then
				shouldShow = charmConfig.Visible
			else
				shouldShow = CONFIG.DisplaySettings.ShowAllByDefault
			end

			v.Visible = shouldShow
			
			if charmConfig then
				local unlocked = isfile(charmConfig.UnlockFile) or charmConfig.TestMode == true

				if charmConfig.IsTBA then
					tbaOrder += 1
					v.LayoutOrder = tbaOrder
				elseif unlocked and not charmConfig.IsUpcoming then
					unlockOrder += 1
					v.LayoutOrder = unlockOrder
				elseif charmConfig.IsUpcoming then
					upcomingOrder += 1
					v.LayoutOrder = upcomingOrder
				else
					lockOrder += 1
					v.LayoutOrder = lockOrder
				end
			end

			if shouldShow then
				ApplyAnimationToButton(v)

				local icons = v:FindFirstChild("Icons")
				if icons then
