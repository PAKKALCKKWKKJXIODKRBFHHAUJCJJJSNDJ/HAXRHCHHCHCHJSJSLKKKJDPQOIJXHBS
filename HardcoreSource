-- Audio ID Configuration for Seek
local SEEK_REPLACEMENT_ID = "https://github.com/cakmay227-svg/random/raw/refs/heads/main/YTDown.com_YouTube_Seek-Hard-Mode-Ost_Media_cAjv2KH_Vc0_001_1080p.mp3?raw=true"

-- Helper function to cache GitHub sounds
local function cacheGitSound(GithubSoundPath: string, AssetName: string?): string
    local Url = GithubSoundPath
    local safeName = AssetName or tostring(Url):gsub("[^%w]", "_")
    local fileName = safeName .. ".mp3"

    if not isfile(fileName) then
        writefile(fileName, game:HttpGet(Url))
    end

    return getcustomasset(fileName, true)
end

local customSeekId = cacheGitSound(SEEK_REPLACEMENT_ID, "SeekMusicTheme")

-- Function to handle sound replacement for Seek only
local function setupSound(sound)
    if not sound:IsA("Sound") then return end

    if sound.Name == "SeekMusic" then
        sound.SoundId = customSeekId
        sound.Volume = 2.2
        sound:GetPropertyChangedSignal("SoundId"):Connect(function()
            if sound.SoundId ~= customSeekId then
                sound.SoundId = customSeekId
            end
        end)
    end
end

-- Scan existing sounds in the game
for _, descendant in ipairs(workspace:GetDescendants()) do
    setupSound(descendant)
end

-- Listen for newly added sounds using DescendantAdded
workspace.DescendantAdded:Connect(function(descendant)
    setupSound(descendant)
end)
