local function TextPop(lbl, delayTime)
	local pos = lbl.Position
	local busy = false

	local function Play()  
		if busy then  
			return  
		end  

		busy = true  

		task.delay(delayTime or 0, function()  
			lbl.Position = pos + UDim2.new(0, 0, 0, CONFIG.Animation.TextPopOffset)  

			TweenService:Create(  
				lbl,  
				TweenInfo.new(  
					CONFIG.Animation.TextPopDuration,  
					Enum.EasingStyle.Back,  
					Enum.EasingDirection.Out  
				),  
				{  
					Position = pos  
				}  
			):Play()  

			task.wait(CONFIG.Animation.TextPopDuration)  
			busy = false  
		end)  
	end  

	lbl:GetPropertyChangedSignal("Text"):Connect(Play)  

	return Play
end

