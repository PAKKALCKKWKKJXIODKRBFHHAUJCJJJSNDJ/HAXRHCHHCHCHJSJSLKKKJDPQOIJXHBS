local function hasAncestorContaining(object, text)
	local parent = object.Parent

	while parent do
		if parent:IsA("Model") then
			if string.find(string.lower(parent.Name), text, 1, true) then
				return true
			end
		end

		if parent == CurrentRooms then
			break
		end

		parent = parent.Parent
	end

	return false
end

local function isBlacklisted(object)
	local name = string.lower(object.Name)

	if object:IsA("BasePart") then
		if string.find(name, "book", 1, true) then
			return not hasAncestorContaining(object, "book")
		end

		if string.find(name, "light", 1, true) then
			return not hasAncestorContaining(object, "book")
		end

		if string.find(name, "wall", 1, true) then
			return not hasAncestorContaining(object, "pillar")
		end

		if string.find(name, "board", 1, true) then
			return not hasAncestorContaining(object, "wooden")
		end
	end

	for _, blacklistName in ipairs(blacklist) do
		if string.find(name, blacklistName, 1, true) then
			return true
		end
	end

	return false
end

local function isInside(instance, model)
	return instance == model or instance:IsDescendantOf(model)
end

local function hasTargetParent(model, room)
	local parent = model.Parent

	while parent and parent ~= room do
		if parent:IsA("Model") and not isBlacklisted(parent) then
			return true
		end

		parent = parent.Parent
	end

	return false
end

local function shakeCollision(collision)
	if not collision or collision.Anchored then
		return
	end

	local mass = collision.AssemblyMass
	local force = mass * 5

	for i = 1, 8 do
		if collision.Parent and not collision.Anchored then
			local look = collision.CFrame.LookVector
			look = Vector3.new(look.X, 0, look.Z)

			if look.Magnitude > 0 then
				look = look.Unit

				local angle = math.rad(math.random(-60, 60))
				local direction = CFrame.fromAxisAngle(
					Vector3.yAxis,
					angle
				):VectorToWorldSpace(look)

				direction = Vector3.new(
					direction.X,
					0,
					direction.Z
				).Unit

				collision:ApplyImpulse(direction * force)

				collision:ApplyAngularImpulse(
					Vector3.new(
						math.random(-1, 1),
						math.random(-1, 1),
						math.random(-1, 1)
					) * mass * 15
				)
			end

			task.wait(0.03)
		end
	end
end

local function setupModel(model, room, targets)
	if not model:IsA("Model") then
		return
	end

	if isBlacklisted(model) then
		return
	end

	if hasTargetParent(model, room) then
		return
	end

	local existingCollision
	local hasScriptCollision = false

	for _, v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart")
			and v.Name == "Collision"
			and v:GetAttribute("WindCollision") == true then

			hasScriptCollision = true

			if v:GetAttribute("Picked") ~= true then
				existingCollision = v
				break
			end
		end
	end

	if existingCollision then
		table.insert(targets, existingCollision)
		return
	end

	if hasScriptCollision then
		return
	end

	local parts = {}

	for _, v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart")
			and v.Name ~= "Collision"
			and not isBlacklisted(v) then

			table.insert(parts, v)
		end
	end

	if #parts == 0 then
		return
	end

	local cf, size = model:GetBoundingBox()

	local volume = size.X * size.Y * size.Z

	if volume <= 0 then
		return
	end

	local density = math.clamp(
		TARGET_MASS / volume,
		0.0001,
		100
	)

	local collision = Instance.new("Part")

	collision.Name = "Collision"
	collision.Size = size
	collision.CFrame = cf

	collision.Transparency = 1
	collision.CanCollide = true
	collision.CanTouch = true
	collision.CanQuery = true
	collision.CastShadow = false

	collision.Anchored = true
	collision.Massless = false

	collision.CustomPhysicalProperties = PhysicalProperties.new(
		density,
		0.3,
		0.5,
		1,
		1
	)

	collision:SetAttribute("WindCollision", true)
	collision:SetAttribute("Picked", false)

	collision.Parent = model

	table.insert(targets, collision)

	collision:GetPropertyChangedSignal("Anchored"):Connect(function()
		if not collision.Anchored then
			task.spawn(shakeCollision, collision)
		end
	end)

	for _, v in ipairs(model:GetDescendants()) do
		if v:IsA("WeldConstraint")
			or v:IsA("Weld")
			or v:IsA("ManualWeld")
			or v:IsA("Motor6D")
			or v:IsA("Snap")
			or v:IsA("Glue")
			or v:IsA("RigidConstraint") then

			local p0 = v.Part0
			local p1 = v.Part1

			if p0 and p1 then
				if isInside(p0, model) ~= isInside(p1, model) then
					v:Destroy()
				end
			end
		end
	end

	for _, part in ipairs(parts) do
		part.Anchored = false
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true

		local weld = Instance.new("WeldConstraint")

		weld.Part0 = collision
		weld.Part1 = part
		weld.Parent = collision
	end
end

local function processRoom(room)
	if not room or not room.Parent then
		return
	end

	local targets = {}

	for _, v in ipairs(room:GetDescendants()) do
		if v:IsA("Model") then
			setupModel(v, room, targets)
		end
	end

	for _, collision in ipairs(targets) do
		if collision
			and collision.Parent
			and collision:GetAttribute("WindCollision") == true then

			collision.Anchored = false
		end
	end
end

local function getRooms()
	local rooms = {}

	for _, room in ipairs(CurrentRooms:GetChildren()) do
		if room:IsA("Model") then
			local number = tonumber(room.Name)

			if number then
				rooms[number] = room
			end
		end
	end

	return rooms
end

task.spawn(function()
	local rooms = getRooms()

	local lowestRoom
	local highestRoom

	for number in pairs(rooms) do
		if not lowestRoom or number < lowestRoom then
			lowestRoom = number
		end

		if not highestRoom or number > highestRoom then
			highestRoom = number
		end
	end

	if not lowestRoom or not highestRoom or lowestRoom == highestRoom then
		return
	end

	for roomNumber = lowestRoom, highestRoom - 1 do
		local room

		repeat
			room = CurrentRooms:FindFirstChild(tostring(roomNumber))

			if not room then
				task.wait(0.1)
			end
		until room

		processRoom(room)

		task.wait(1)
	end
end)
