local CurrentRooms = workspace:WaitForChild("CurrentRooms")

local TARGET_MASS = 0

local blacklist = {
	"wardrobe",
	"rafter",
	"bed",
	"rug",
	"carpet",
	"sideroom",
	"key",
	"drawer",
	"breaker",
	"table",
	"desk",
	"gold",
	"dresser",
	"floor",
	"wall",
	"door",
	"ceiling",
	"light",
	"beam",
	"window",
	"curtain",
	"gate",
	"stairs",
	"vent",
	"lattice",
	"barrelstack",
	"smoothie",
	"rolltop",
	"dupe",
	"boards",
	"crucifix",
	"flashlight",
	"moonfloat",
	"lockpick",
	"candle",
	"skeleton key",
	"fireplace"
}

local processed = {}

local function hasAncestorContaining(object, text)
	local parent = object.Parent

	while parent do
		if parent:IsA("Model") then
			if string.find(
				string.lower(parent.Name),
				text,
				1,
				true
			) then
				return true
			end
		end

		if parent == CurrentRooms then
			break
		end

		parent = parent.Parent
	end

	return false
end

local function isBlacklisted(object)
	local name = string.lower(object.Name)

	if object:IsA("BasePart") then
		if string.find(name, "book", 1, true) then
			return not hasAncestorContaining(object, "book")
		end

		if string.find(name, "light", 1, true) then
			return not hasAncestorContaining(object, "book")
		end

		if string.find(name, "wall", 1, true) then
			return not hasAncestorContaining(object, "pillar")
		end

		if string.find(name, "board", 1, true) then
			return not hasAncestorContaining(object, "wooden")
		end
	end

	for _, blacklistName in ipairs(blacklist) do
		if string.find(name, blacklistName, 1, true) then
			return true
		end
	end

	return false
end

local function isInside(instance, model)
	return instance == model or instance:IsDescendantOf(model)
end

local function hasTargetParent(model, room)
	local parent = model.Parent

	while parent and parent ~= room do
		if parent:IsA("Model") and not isBlacklisted(parent) then
			return true
		end

		parent = parent.Parent
	end

	return false
end

local function shakeCollision(collision)
	if not collision or collision.Anchored then
		return
	end

	local mass = collision.AssemblyMass
	local force = mass * 35

	for i = 1, 8 do
		if collision.Parent and not collision.Anchored then
			local direction = Vector3.new(
				math.random(-100, 100) / 100,
				math.random(20, 100) / 100,
				math.random(-100, 100) / 100
			).Unit

			collision:ApplyImpulse(direction * force)

			collision:ApplyAngularImpulse(
				Vector3.new(
					math.random(-3, 3),
					math.random(-3, 3),
					math.random(-3, 3)
				) * mass * 15
			)

			task.wait(0.03)
		end
	end
end

local function setupModel(model, room)
	if not model:IsA("Model") then
		return
	end

	if processed[model] then
		return processed[model]
	end

	if isBlacklisted(model) then
		processed[model] = false
		return
	end

	if hasTargetParent(model, room) then
		processed[model] = false
		return
	end

	local existingCollision
	local hasScriptCollision = false

	for _, v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart")
			and v.Name == "Collision"
			and v:GetAttribute("WindCollision") == true then

			hasScriptCollision = true

			if v:GetAttribute("Picked") ~= true then
				existingCollision = v
				break
			end
		end
	end

	if existingCollision then
		processed[model] = existingCollision
		return existingCollision
	end

	if hasScriptCollision then
		processed[model] = false
		return
	end

	local parts = {}

	for _, v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart")
			and v.Name ~= "Collision"
			and not isBlacklisted(v) then

			table.insert(parts, v)
		end
	end

	if #parts == 0 then
		processed[model] = false
		return
	end

	local cf, size = model:GetBoundingBox()
	local volume = size.X * size.Y * size.Z

	if volume <= 0 then
		processed[model] = false
		return
	end

	local density = math.clamp(
		TARGET_MASS / volume,
		0.0001,
		100
	)

	local collision = Instance.new("Part")

	collision.Name = "Collision"
	collision.Size = size
	collision.CFrame = cf
	collision.Transparency = 1

	collision.CanCollide = true
	collision.CanTouch = true
	collision.CanQuery = true
	collision.CastShadow = false

	collision.Anchored = true
	collision.Massless = false

	collision.CustomPhysicalProperties = PhysicalProperties.new(
		density,
		0.3,
		0.5,
		1,
		1
	)

	collision:SetAttribute("WindCollision", true)
	collision:SetAttribute("Picked", false)

	collision.Parent = model

	processed[model] = collision

	collision:GetPropertyChangedSignal("Anchored"):Connect(function()
		if not collision.Anchored then
			task.spawn(shakeCollision, collision)
		end
	end)

	for _, v in ipairs(model:GetDescendants()) do
		if v:IsA("WeldConstraint")
			or v:IsA("Weld")
			or v:IsA("ManualWeld")
			or v:IsA("Motor6D")
			or v:IsA("Snap")
			or v:IsA("Glue")
			or v:IsA("RigidConstraint") then

			local p0 = v.Part0
			local p1 = v.Part1

			if p0 and p1 then
				if isInside(p0, model) ~= isInside(p1, model) then
					v:Destroy()
				end
			end
		end
	end

	for _, part in ipairs(parts) do
		part.Anchored = false
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true

		local weld = Instance.new("WeldConstraint")

		weld.Part0 = collision
		weld.Part1 = part
		weld.Parent = collision
	end

	return collision
end

local function activateTarget(collision)
	if not collision or not collision.Parent then
		return
	end

	if collision:GetAttribute("WindCollision") ~= true then
		return
	end

	if collision:GetAttribute("Picked") == true then
		return
	end

	collision:SetAttribute("Picked", true)
	collision.Anchored = false
end

local function canSeeTarget(origin, targetModel, ignore)
	local targetPart

	if targetModel.PrimaryPart then
		targetPart = targetModel.PrimaryPart
	else
		targetPart = targetModel:FindFirstChildWhichIsA("BasePart", true)
	end

	if not targetPart then
		return false
	end

	local direction = targetPart.Position - origin

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true

	local result = workspace:Raycast(
		origin,
		direction,
		params
	)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(targetModel)
end

local function processRipper(ripper)
	local cf, size = ripper:GetBoundingBox()

	local hitbox = Instance.new("Part")

	hitbox.Name = "RipperHitbox"
	hitbox.Size = Vector3.new(50, 50, 50)
	hitbox.CFrame = cf

	hitbox.Transparency = 1
	hitbox.CanCollide = false
	hitbox.CanTouch = true
	hitbox.CanQuery = true
	hitbox.Anchored = true
	hitbox.CastShadow = false

	hitbox.Parent = ripper

	local overlapParams = OverlapParams.new()

	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = {
		ripper,
		hitbox
	}

	local touching = workspace:GetPartsInPart(
		hitbox,
		overlapParams
	)

	local foundModels = {}

	for _, part in ipairs(touching) do
		if part:IsA("BasePart") then
			local model = part:FindFirstAncestorOfClass("Model")

			if model
				and model ~= ripper
				and model:IsDescendantOf(CurrentRooms)
				and not foundModels[model] then

				foundModels[model] = true

				local room = model.Parent

				if room
					and room.Parent == CurrentRooms
					and canSeeTarget(
						hitbox.Position,
						model,
						{ripper, hitbox, model}
					) then

					local collision = setupModel(model, room)

					if collision then
						activateTarget(collision)
					end
				end
			end
		end
	end
end

local ripper = workspace:FindFirstChild("RipperBla")

if ripper and ripper:IsA("Model") then
	processRipper(ripper)
end
