	for _, data in ipairs(selected) do
		local Part = Instance.new("Part")
		Part.Name = "EntityBillboardPart"
		Part.Anchored = true
		Part.CanCollide = false
		Part.CanTouch = false
		Part.CanQuery = false
		Part.Transparency = 1

		local size = data.Size

		Part.Size = Vector3.new(
			math.max(size.X, 0.1),
			math.max(size.Y, 0.1),
