local function Blank() 
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local GameData = ReplicatedStorage:WaitForChild("GameData")
	local LatestRoom = GameData:WaitForChild("LatestRoom")
	local CurrentRooms = workspace:WaitForChild("CurrentRooms")

	local function GetCurrentRoom()
		return CurrentRooms:FindFirstChild(tostring(LatestRoom.Value))
	end

	local function GetModels(room)
		local models = {}

		for _, v in ipairs(room:GetDescendants()) do
			if v:IsA("Model") then
				local cf, size = v:GetBoundingBox()

				if size.X > 0 and size.Y > 0 and size.Z > 0 then
					table.insert(models, {
						Model = v,
						CFrame = cf,
						Size = size
					})
				end
			end
		end

		return models
	end

	local room = GetCurrentRoom()

	if not room then
		return
	end

	local models = GetModels(room)

	if #models == 0 then
		return
	end

	local amount = math.min(math.random(5, 10), #models)

	local selected = {}

	while #selected < amount do
		local data = models[math.random(1, #models)]

		if not table.find(selected, data) then
			table.insert(selected, data)
		end
	end

	for _, data in ipairs(selected) do
		local Part = Instance.new("Part")
		Part.Name = "EntityBillboardPart"
		Part.Anchored = true
		Part.CanCollide = false
		Part.CanTouch = false
		Part.CanQuery = false
		Part.Transparency = 1

		local size = data.Size

		Part.Size = Vector3.new(
			math.max(size.X, 0.1),
			math.max(size.Y, 0.1),
			math.max(size.Z, 0.1)
		)

		Part.CFrame = data.CFrame
		Part.Parent = workspace

		local Billboard = Instance.new("BillboardGui")
		Billboard.Name = "EntityBillboard"
		Billboard.AlwaysOnTop = false
		Billboard.Size = UDim2.fromOffset(
			math.max(size.X * 10, 1),
			math.max(size.Y * 10, 1)
		)
		Billboard.StudsOffset = Vector3.new(0, 3, 0)
		Billboard.MaxDistance = math.huge
		Billboard.Adornee = Part
		Billboard.Parent = Part

		local Frame = Instance.new("Frame")
		Frame.Name = "Background"
		Frame.BackgroundColor3 = Color3.new(0, 0, 0)
		Frame.BackgroundTransparency = 0
		Frame.BorderSizePixel = 0
		Frame.Size = UDim2.fromScale(1, 1)
		Frame.Position = UDim2.fromScale(0.5, 0.5)
		Frame.AnchorPoint = Vector2.new(0.5, 0.5)
		Frame.Parent = Billboard
	end
end

