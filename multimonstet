local function GetModels(room)
	local models = {}

	for _, v in ipairs(room:GetDescendants()) do
		if v:IsA("Model") then
			local cf, size = v:GetBoundingBox()

			if size.X > 0 and size.Y > 0 and size.Z > 0 then
				table.insert(models, {
					Model = v,
					CFrame = cf,
					Size = size
				})
			end
		end
	end

	return models
end

