local TweenService = game:GetService("TweenService")
local Camera = workspace.CurrentCamera

local function setGuiTransparency(value, speed)
	for _, v in ipairs(guiObjects) do
		TweenService:Create(
			v,
			TweenInfo.new(speed, Enum.EasingStyle.Linear),
			{
				ImageTransparency = v:IsA("ImageLabel") and value or v.ImageTransparency
			}
		):Play()
	end
end

local function getCore()
	for core in pairs(EyesData) do
		if core and core.Parent then
			return core
		end
	end
end

local function isLooking(core)
	local dir = core.Position - Camera.CFrame.Position
	local dot = Camera.CFrame.LookVector:Dot(dir.Unit)

	if dot < 0.9 then
		return false
	end

	local result = workspace:Raycast(
		Camera.CFrame.Position,
		dir
	)

	return result and result.Instance and result.Instance:IsDescendantOf(core.Parent)
end


task.spawn(function()
	while true do
		task.wait()

		if not gui or not gui.Parent then
			continue
		end

		local core = getCore()
		if not core then
			continue
		end

		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")

		if hrp then
			local dist = (hrp.Position - core.Position).Magnitude

			setGuiTransparency(math.clamp(dist / 100,0,1),0.5)

			if isLooking(core) then
				setGuiTransparency(0,0.5)
			end
		end
	end
end)

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

RunService.RenderStepped:Connect(function()
	if DisableLook then
		for _, data in pairs(EyesData) do
			data.Looking = false
			if data.Angry then
				data.Angry.Enabled = false
			end
		end
		return
	end

	local char = LocalPlayer.Character
	if not char then
		return
	end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {char}

	for core, data in pairs(EyesData) do
		local looking = false

		if core.Parent then
			local dir = core.Position - Camera.CFrame.Position
			local dist = dir.Magnitude

			if dist <= 1000 then
				local dot = Camera.CFrame.LookVector:Dot(dir.Unit)

				if dot >= 0.9 then -- giảm xuống 0.85 hoặc 0.8 nếu muốn góc nhìn rộng hơn
					local result = workspace:Raycast(
						Camera.CFrame.Position,
						dir,
						params
					)

					looking = result
						and result.Instance
						and result.Instance:IsDescendantOf(core.Parent)
				end
			end
		end

		if looking and EyesActive then
			if not data.Looking then
				data.Looking = true

				if data.Attack then
					data.Attack:Play()
				end
			end

			if data.Angry then
				data.Angry.Enabled = true
			end

			if tick() - data.LastDamage >= 0.2 then
				data.LastDamage = tick()

				hum:TakeDamage(5)
				
				game.ReplicatedStorage.GameStats['Player_' .. game.Players.LocalPlayer.Name].Total.DeathCause.Value = 'Eyes'

				spawnShake:ShakeOnce(
					4,
					12,
					0.05,
					0.45,
					0,
					0.8
				)
			end
		else
			data.Looking = false

			if data.Angry then
				data.Angry.Enabled = false
			end
		end
	end
end)

