local function Start()
	if running then return end
	running = true

	local lowestRoom = math.huge
	local roomCount = 0

	for _,room in ipairs(_CurrentRooms62:GetChildren()) do
		local number = tonumber(room.Name)

		if number then
			roomCount += 1

			if number < lowestRoom then
				lowestRoom = number
			end
		end
	end

	local spawnFrom

	if roomCount <= 3 then
		spawnFrom = lowestRoom
	else
		spawnFrom = lowestRoom + 2
	end

	while true do
		local data = table.remove(roomQueue, 1)

		if data then
			if data.number >= spawnFrom then
				local destroyed = SpawnInRoom(data.room)

				if destroyed then
					break
				end

				task.wait(1)
			end
		else
			task.wait(0.1)
		end
	end
end


