local function TweenSprintBar(exhausted)
	for obj, color in pairs(OriginalColors) do
		if obj and obj.Parent then
			local goal

			if obj:IsA("GuiObject") then
				goal = {
					BackgroundColor3 = exhausted and ExhaustedColor or color
				}
			elseif obj:IsA("UIStroke") then
				goal = {
					Color = exhausted and ExhaustedColor or color
				}
			end

			if goal then
				TweenService:Create(
					obj,
					TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					goal
				):Play()
			end
		end
	end
end

