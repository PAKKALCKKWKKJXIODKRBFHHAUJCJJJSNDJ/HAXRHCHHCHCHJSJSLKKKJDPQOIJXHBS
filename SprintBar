local function UpdateBonus()
	local hp = Humanoid.Health
	local max = Humanoid.MaxHealth

	-- 100 HP = 0
	-- 5 HP = 5
	local lost = max - hp

	local RawHealth = math.clamp(
	math.floor((lost / (max - 5)) * 5),
	0,
	5
)

if RawHealth == 1 then
	HealthBonus = 0
elseif RawHealth == 2 then
	HealthBonus = 2
elseif RawHealth == 3 then
	HealthBonus = 2
elseif RawHealth == 4 then
	HealthBonus = 4
elseif RawHealth >= 5 then
	HealthBonus = 5
else
	HealthBonus = 0
end

	local Total = HealthBonus + RipperBonus

	if Total > 13 then
		Total = 13
	end

	if Label then
	local Display = math.floor(Total)

if Display == 1 then
	Display = 0
elseif Display == 3 then
	Display = 2
end

if HealthBonus >= 5 then
	Display = 5
end

	Label.Text = Label.Text:gsub("%d+%.?%d*", tostring(Display), 1)
end

		Humanoid.WalkSpeed = BaseSpeed + Total
end

