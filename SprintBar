)

local SprintEffect = LoadObject(
	"Place_131351567799504_ImageLabel_HC_StaminaVignette_1785381333.txt",
	"https://raw.githubusercontent.com/lynguyen26031993-design/-u/refs/heads/main/Place_131351567799504_ImageLabel_HC_StaminaVignette_1785381333%20(1).txt",
