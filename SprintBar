local IsMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

SprintButton.Visible = IsMobile

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")

local BaseSpeed = Humanoid.WalkSpeed

local Bar = MainFrame.HC_Sprintbar.Bar.Bar
local ExhaustedColor = Color3.fromRGB(172, 36, 38)
local OriginalColors = {}

for _, v in ipairs(SprintBar:GetDescendants()) do
	if v:IsA("GuiObject") then
		OriginalColors[v] = v.BackgroundColor3
	elseif v:IsA("UIStroke") then
		OriginalColors[v] = v.Color
	end
end

OriginalColors[SprintBar] = SprintBar.BackgroundColor3

local function TweenSprintBar(exhausted)
	for obj, color in pairs(OriginalColors) do
		if obj and obj.Parent then
			local goal

			if obj:IsA("GuiObject") then
				goal = {
					BackgroundColor3 = exhausted and ExhaustedColor or color
				}
			elseif obj:IsA("UIStroke") then
				goal = {
					Color = exhausted and ExhaustedColor or color
				}
			end

			if goal then
				TweenService:Create(
					obj,
					TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					goal
				):Play()
			end
		end
	end
end

local Sprinting = false
local Disabled = false
local MaxStamina = 115
local RecoverDelay = false
local Stamina = MaxStamina
getgenv().Stamina = 100

getgenv().HalfStamina = function(time)
	time = time or 0.4

	local start = Stamina
	local target = start * 0.5

	local t = 0

	while t < time do
		t += task.wait()
		local alpha = math.clamp(t / time, 0, 1)
		Stamina = start + (target - start) * alpha
	end

	Stamina = target
end

getgenv().SetStamina = function(percent, time)
	time = time or 0.4

	local start = Stamina
	local currentPercent = (start / MaxStamina) * 100
	local targetPercent = math.clamp(currentPercent + percent, 0, 100)
	local target = MaxStamina * (targetPercent / 100)

	local t = 0

	while t < time do
		t += task.wait()
		local alpha = math.clamp(t / time, 0, 1)
		Stamina = start + (target - start) * alpha
	end

	Stamina = target
end

local function SetSprint(state)
	Sprinting = state

	if state then
		SprintButton.Image = "rbxassetid://17674431627"
	else
		SprintButton.Image = "rbxassetid://17674431834"
	end
end

local function ToggleSprint()
	if Sprinting then
		SetSprint(false)

		ManualFade = true

		TweenService:Create(
			SprintEffect,
			TweenInfo.new(2),
			{
				ImageTransparency = 1
			}
		):Play()

		task.delay(2, function()
			ManualFade = false
		end)

		if not Disabled then
			Humanoid.WalkSpeed = BaseSpeed
		end
	else
		SetSprint(true)
		ManualFade = false

		if not Disabled then
			Humanoid.WalkSpeed = BaseSpeed + 5
		end
	end
end

if IsMobile then
	SprintButton.MouseButton1Click:Connect(ToggleSprint)
else
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end

		if input.KeyCode == Enum.KeyCode.Q then
			ToggleSprint()
		end
	end)
end

task.spawn(function()
	while true do
		if Humanoid.Parent ~= Character then
			Character = Player.Character or Player.CharacterAdded:Wait()
			Humanoid = Character:WaitForChild("Humanoid")
			BaseSpeed = Humanoid.WalkSpeed
		end

		if Disabled then
			Humanoid.WalkSpeed = BaseSpeed - 2
		end

		task.wait()
	end
end)

local DrainSpeed = 20
local RecoverSpeed = 10

RunService.RenderStepped:Connect(function(dt)
	local moving = Humanoid.MoveDirection.Magnitude > 0

	if Sprinting and moving and not Disabled then
	Stamina -= DrainSpeed * dt
elseif not RecoverDelay and Stamina < MaxStamina then
	Stamina += RecoverSpeed * dt
	if Stamina > MaxStamina then
		Stamina = MaxStamina
	end
end

	local percent = Stamina / MaxStamina
	getgenv().Stamina = percent * 100

	Bar.AnchorPoint = Vector2.new(0, 0.5)
Bar.Position = UDim2.new(0, 0, 0.5, 0)
	Bar.Size = Bar.Size:Lerp(
	UDim2.new(percent, 0, 1, 0),
	math.clamp(dt * 15, 0, 1)
)

	if SprintEffect and Sprinting and not ManualFade then
	local alpha = 1 - ((MaxStamina - Stamina) / MaxStamina)
	SprintEffect.ImageTransparency = math.clamp(alpha, 0, 1)
end

	if Stamina <= 0 and Sprinting and not Disabled then
	Disabled = true
	RecoverDelay = true

	TweenSprintBar(true)

task.spawn(function() 
task.wait(2)


	TweenService:Create(
		SprintEffect,
		TweenInfo.new(5),
		{
			ImageTransparency = 1
		}
	):Play()
	end)

	Humanoid.WalkSpeed = BaseSpeed - 2
	require(game.Players.LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game).caption("You're exhausted.",true)

	task.delay(0.7, function()
		RecoverDelay = false
	end)
end

if Disabled and Stamina >= 95 then
	Disabled = false
	TweenSprintBar(false)

	if Sprinting then
		Humanoid.WalkSpeed = BaseSpeed + 5
	else
		Humanoid.WalkSpeed = BaseSpeed
	end
end
end)

Player.CharacterAdded:Connect(function(char)
	Character = char
	Humanoid = char:WaitForChild("Humanoid")

	BaseSpeed = Humanoid.WalkSpeed

	if Sprinting then
		if Disabled then
			Humanoid.WalkSpeed = BaseSpeed - 2
		else
			Humanoid.WalkSpeed = BaseSpeed + 5
		end
	else
		Humanoid.WalkSpeed = BaseSpeed
	end
end)
