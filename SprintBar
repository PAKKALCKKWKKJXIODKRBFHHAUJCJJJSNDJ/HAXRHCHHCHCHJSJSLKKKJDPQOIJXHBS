local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")

local MainFrame = Player.PlayerGui:WaitForChild("MainUI"):WaitForChild("MainFrame")
local MobileButtons = MainFrame:WaitForChild("MobileButtons")
local HeartBar = MainFrame:WaitForChild("Healthbar")
HeartBar.Position = UDim2.new(0, 10, 0.975000024, -20)

local function LoadObject(file, url, parent)
	if not isfile(file) then
		writefile(file, game:HttpGet(url))
	end

	local asset = getcustomasset(file)
	local obj = game:GetObjects(asset)[1]

	if obj then
		obj.Parent = parent
	end

	return obj
end

local ManualFade = false

local SprintBar = LoadObject(
	"Place_131351567799504_Frame_HC_Sprintbar_1785379229.txt",
	"https://raw.githubusercontent.com/lynguyen26031993-design/-u/refs/heads/main/Place_131351567799504_Frame_HC_Sprintbar_1785379229%20(1).txt",
