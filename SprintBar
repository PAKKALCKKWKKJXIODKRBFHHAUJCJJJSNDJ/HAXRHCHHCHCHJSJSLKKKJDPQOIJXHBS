local function ToggleSprint()
	if Sprinting then
		SetSprint(false)

		ManualFade = true

		TweenService:Create(
			SprintEffect,
			TweenInfo.new(2),
			{
				ImageTransparency = 1
			}
		):Play()

		task.delay(2, function()
			ManualFade = false
		end)

		if not Disabled then
			Humanoid.WalkSpeed = BaseSpeed
		end
	else
		SetSprint(true)
		ManualFade = false

		if not Disabled then
			Humanoid.WalkSpeed = BaseSpeed + 5
		end
	end
end

