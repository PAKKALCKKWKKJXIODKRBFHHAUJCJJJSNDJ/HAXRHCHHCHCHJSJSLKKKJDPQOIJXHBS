-- Hàm cho 1 phòng chớp đèn liên tục
local function FlickerRoomLoop(room)
    task.spawn(function()
        while getgenv().IsAllRoomsFlickering and room and room.Parent do
            if room:IsA("Model") then
                Module_Events.flicker(room, 1)
            end
            task.wait(0.7) -- Thời gian chờ giữa các lần chớp của phòng đó
        end
    end)
end

-- 1. Áp dụng cho các phòng đã có sẵn từ trước
for _, room in next, CurrentRooms:GetChildren() do
    if room:IsA("Model") then
        FlickerRoomLoop(room)
    end
end

-- 2. Tự động áp dụng cho bất kỳ phòng MỚI nào vừa được thêm vào
