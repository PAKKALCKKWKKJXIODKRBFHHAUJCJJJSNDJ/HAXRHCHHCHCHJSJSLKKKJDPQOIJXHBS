    if room:IsA("Model") and getgenv().IsAllRoomsFlickering then
        -- Đợi một chút để phòng load xong các thành phần bên trong
        task.wait(0.5)
        FlickerRoomLoop(room)
        print("Đã thêm phòng mới vào danh sách chớp đèn:", room.Name)
    end
end)

