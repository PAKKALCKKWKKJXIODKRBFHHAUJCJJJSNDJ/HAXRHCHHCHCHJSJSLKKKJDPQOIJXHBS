local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

local CrucifixEntity = loadstring(game:HttpGet(
			"https://raw.githubusercontent.com/iccdjkkkkskskhdgdgegvbfbgncjjdudejdjvi/random/refs/heads/main/crucifix"
		))()

local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

local function GetGitSound(GithubSnd, SoundName)
					local url = GithubSnd
					if not isfile(SoundName .. ".mp3") then
						writefile(SoundName .. ".mp3", game:HttpGet(url))
					end
					local sound = Instance.new("Sound")
					sound.SoundId = (getcustomasset or getsynasset)(SoundName .. ".mp3")
					return sound
				end

local Github = GetGitSound("https://github.com/lynguyen26031993-design/-u/raw/refs/heads/main/XRecorder_Edited_20260810_02.mp3?raw=true", "kcjjdjjjlla")
local breaking

local Github2 = GetGitSound("https://github.com/lynguyen26031993-design/-u/raw/refs/heads/main/XRecorder_Edited_20260810_03.mp3?raw=true", "jcjjjdjjjjjxdd")
local breaking2

local function spawnCustomModel()
    local success, assets = pcall(function()
        return game:GetObjects("rbxassetid://90250291645240")
    end)

    if not success or #assets == 0 then
        warn("Không thể load model.")
        return
    end

    local model = assets[1]
    if not model:IsA("Model") then
        local newModel = Instance.new("Model")
        model.Parent = newModel
        model = newModel
    end
    
    breaking = Instance.new("Sound")
breaking.SoundId = Github.SoundId
breaking.PlaybackSpeed = 1
breaking.Parent = model.Base
breaking.Looped = false
breaking.RollOffMaxDistance = 100
breaking.Volume = 1

Github:Destroy()

breaking2 = Instance.new("Sound")
breaking2.SoundId = Github2.SoundId
breaking2.PlaybackSpeed = 1
breaking2.Parent = model.Base
breaking2.Looped = false
breaking2.RollOffMaxDistance = 50
breaking2.Volume = 1.5

Github2:Destroy()
    
    -- Lưu lại playback speed gốc của từng sound trước khi can thiệp
    local originalPlaybackSpeeds = {}
    
    for _, v in ipairs(model:GetDescendants()) do
        if v:IsA("Sound") then
            originalPlaybackSpeeds[v] = v.PlaybackSpeed
            v:Stop()

            -- Chỉ play các âm thanh cũ theo logic ban đầu
            if v.Name == "PlaySound" and not v.Parent:IsA("Model") then
                v:Play()
            end
        end
    end

    -- 1. Lưu lại tọa độ spawn dựa trên LookVector tại thời điểm gọi (khóa Y)
    local lookVector = humanoidRootPart.CFrame.LookVector
    local flatLookVector = Vector3.new(lookVector.X, 0, lookVector.Z).Unit
    if flatLookVector.Magnitude == 0 then
        flatLookVector = Vector3.new(0, 0, -1)
    end
    
    local initialSpawnPos = humanoidRootPart.Position + (flatLookVector * 20)
    initialSpawnPos = Vector3.new(initialSpawnPos.X, humanoidRootPart.Position.Y, initialSpawnPos.Z)

    -- Lưu vị trí ban đầu của HumanoidRootPart để tính độ dịch chuyển (movement)
    local initialRootPos = humanoidRootPart.Position

    local primaryPart = model:FindFirstChild("Base")
    if not primaryPart or not primaryPart:IsA("BasePart") then
        return
    end

    model.PrimaryPart = primaryPart
    model:SetPrimaryPartCFrame(CFrame.new(initialSpawnPos))
    model.Parent = workspace

    -- Biến kiểm soát trạng thái bám theo movement
    local isFollowingMovement = true

    -- Cập nhật liên tục để model dịch chuyển theo delta movement của HumanoidRootPart
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not isFollowingMovement or not model.Parent or not humanoidRootPart then
            if connection then connection:Disconnect() end
            return
        end

        local currentRootPos = humanoidRootPart.Position
        local movementDelta = currentRootPos - initialRootPos

        local newPos = Vector3.new(
            initialSpawnPos.X + movementDelta.X,
            initialSpawnPos.Y,
            initialSpawnPos.Z + movementDelta.Z
        )

        primaryPart.CFrame = CFrame.new(newPos)
    end)
    
    -- 2. Sau 1.3 giây, tween các sound tồn tại trong model lên playback 3
    task.delay(1.3, function()
	local randomWait = math.random(5, 15) / 10

	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("Sound") then
			local tweenInfo = TweenInfo.new(
				1.5,
				Enum.EasingStyle.Linear,
				Enum.EasingDirection.Out
			)

			local speedTween = TweenService:Create(
				obj,
				tweenInfo,
				{PlaybackSpeed = 3}
			)

			speedTween:Play()

			task.spawn(function()
				task.wait(randomWait)
				speedTween:Cancel()
			end)
		end
	end

	task.wait(randomWait)
        
        for _, obj in ipairs(model:GetDescendants()) do
            if obj:IsA("Sound") then
                if originalPlaybackSpeeds[obj] then
                    obj.PlaybackSpeed = originalPlaybackSpeeds[obj]
                end
            end
        end
        
        -- Stop tất cả sound và play HORROR SCREAM 15 khi va chạm/kết thúc giai đoạn bám theo
        for _, obj in ipairs(model:GetDescendants()) do
            if obj:IsA("Sound") then
                obj:Stop()

                if obj.Name == "HORROR SCREAM 15" then
                    obj.TimePosition = 0
                    
                    
                    
                   
                    obj:Play()
                end
            end
        end
        
        breaking:Play() 
        
        for _, v in ipairs(model:GetDescendants()) do
	if v:IsA("ParticleEmitter") and (
		(v.Parent:IsA("Attachment") and v.Parent.Name == "Faces")
		or
		(v.Parent:IsA("BasePart") and v.Parent.Name == "Face2")
	) then
		v.Texture = "rbxassetid://140603766411805"
	end
end

for _, v in ipairs(model:GetDescendants()) do
	if v:IsA("ParticleEmitter") and (
		(v.Parent:IsA("Attachment") and v.Parent.Name == "Faces")
		or
		(v.Parent:IsA("BasePart") and v.Parent.Name == "Face2")
	) then
		local size = v.Size
		local keypoints = {}

		for _, keypoint in ipairs(size.Keypoints) do
			table.insert(keypoints, NumberSequenceKeypoint.new(
				keypoint.Time,
				keypoint.Value * 1.25,
				keypoint.Envelope * 1.25
			))
		end

		v.Size = NumberSequence.new(keypoints)
	end
end
        
        -- Dừng việc bám theo movement của player
        isFollowingMovement = false

        if connection then
            connection:Disconnect()
        end

        if not model.Parent then
            return
        end

        -- Bay thẳng theo hướng HumanoidRootPart tại thời điểm bắt đầu
local flyDirection = (humanoidRootPart.Position - primaryPart.Position).Unit
local flySpeed = 30
local flying = true
local hitCharacter = false
local canHitObjects = false
local crucifixStopped = false
local flyStartTime = tick()

task.delay(0.4, function()
	canHitObjects = true
end)

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude
overlapParams.FilterDescendantsInstances = {model}

local flyConnection
flyConnection = RunService.Heartbeat:Connect(function(dt)
	if not flying or not model.Parent then
		if flyConnection then
			flyConnection:Disconnect()
		end
		return
	end

	local elapsed = tick() - flyStartTime
local duration = 2

local alpha = math.clamp(elapsed / duration, 0, 1)

local easedAlpha = alpha ^ 4

local startSpeed = 25
local endSpeed = 1000

local speed = startSpeed + (endSpeed - startSpeed) * easedAlpha

	local currentCFrame = primaryPart.CFrame
	local nextCFrame = currentCFrame + flyDirection * speed * dt

	local parts = workspace:GetPartBoundsInBox(
		nextCFrame,
		primaryPart.Size,
		overlapParams
	)

	for _, part in ipairs(parts) do
	if part:IsA("BasePart") then
		if part:IsDescendantOf(character) then
			if not hitCharacter then
				hitCharacter = true

				local equippedTool

				for _, obj in ipairs(character:GetChildren()) do
					if obj:IsA("Tool") then
						equippedTool = obj
						break
					end
				end

				if equippedTool and equippedTool.Name == "Crucifix" then
	local entity = model

	if entity then
	task.spawn(function() 

		CrucifixEntity({
			Target = entity,
			Resist = false,
			RequiredDistance = 40,
			Color = "Default",
			Symbol = "Moon"
		})
		end) 
	end

	local playSound = model.Base:FindFirstChild("Repent", true)

	if playSound and playSound:IsA("Sound") then
		playSound.PlaybackSpeed = 2
	 playSound.Volume = 4
		playSound:Play()
	end

	crucifixStopped = true
	flying = false
	break
end

				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid:TakeDamage(20)
				end
			end

			flying = false
			break
		elseif canHitObjects then
			flying = false
			break
		end
	end
end

	if not flying and not crucifixStopped then
		if flyConnection then
			flyConnection:Disconnect()
		end

		breaking2:Play()

		for _, obj in ipairs(model:GetDescendants()) do
			if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
				obj.Range = obj.Range * 3
				TweenService:Create(
					obj,
					TweenInfo.new(0.5, Enum.EasingStyle.Linear),
					{Range = 0}
				):Play()
			end
		end

		for _, obj in ipairs(model:GetDescendants()) do
			if obj:IsA("ParticleEmitter") then
				local original = obj.Transparency

				task.spawn(function()
					local start = tick()

					while obj.Parent do
						local alpha = math.clamp((tick() - start) / 1, 0, 1)
						local keypoints = {}

						for _, keypoint in ipairs(original.Keypoints) do
							table.insert(keypoints, NumberSequenceKeypoint.new(
								keypoint.Time,
								keypoint.Value + (1 - keypoint.Value) * alpha,
								keypoint.Envelope
							))
						end

						obj.Transparency = NumberSequence.new(keypoints)

						if alpha >= 1 then
							break
						end

						RunService.Heartbeat:Wait()
					end
				end)
			end
		end

		local horrorScream = model:FindFirstChild("HORROR SCREAM 15", true)
		if horrorScream and horrorScream:IsA("Sound") then
			horrorScream.Looped = false
			horrorScream.Ended:Wait()
		end

		if model.Parent then
			model:Destroy()
		end
	else
		primaryPart.CFrame = nextCFrame
	end
end)
    end)
end

spawnCustomModel()
