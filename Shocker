local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local function GetGitSound(GithubSnd, SoundName)
			local url = GithubSnd
			if not isfile(SoundName .. ".mp3") then
				writefile(SoundName .. ".mp3", game:HttpGet(url))
			end
			local sound = Instance.new("Sound")
			sound.SoundId = (getcustomasset or getsynasset)(SoundName .. ".mp3")
			return sound
		end
		
		local endfinished = GetGitSound("https://github.com/lynguyen26031993-design/-u/raw/refs/heads/main/shocker%20finish%20attack%20(1).mp3?raw=true", "ppclkkjsjsjhxjkxk")
		local flyinnggg = GetGitSound("https://github.com/lynguyen26031993-design/-u/raw/refs/heads/main/virtual_vibes-electric-shock-404227%20(1).mp3?raw=true", "pppvplkdkjwjkkkc")

local LocalPlayer = Players.LocalPlayer

local function LoadModel(file, url)
	if not isfile(file) then
		writefile(file, game:HttpGet(url))
	end

	return game:GetObjects(getcustomasset(file))[1]
end

local ShockerTemplate = LoadModel(
		"shoocokkkdd",
		"https://github.com/lynguyen26031993-design/-u/raw/refs/heads/main/Place_131351567799504_Model_Shocknjder_1788101823.txt"
	)

local LiveModifiers = ReplicatedStorage:WaitForChild("LiveModifiers")

local function getCharacter()
	local char = LocalPlayer.Character

	if not char or not char.Parent then
		char = LocalPlayer.CharacterAdded:Wait()
	end

	return char
end

local function getFlatDirection(cf)
	local look = cf.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)

	if flat.Magnitude < 0.001 then
		return Vector3.new(0, 0, -1)
	end

	return flat.Unit
end

local function getCameraDirection(target)
	local camera = workspace.CurrentCamera

	if camera then
		return getFlatDirection(camera.CFrame)
	end

	return getFlatDirection(target:GetPivot())
end

local function destroyHitbox(hitbox)
	if hitbox and hitbox.Parent then
		hitbox.CanQuery = false
		hitbox.CanTouch = false
		hitbox:Destroy()
	end
end

local function EndShocker(model, parent, hitbox)
	destroyHitbox(hitbox)

	if not model or not model.Parent then
		return
	end

	local endSound = Instance.new("Sound")
	endSound.Name = "ShockerEnd"
	endSound.SoundId = endfinished.SoundId
	endSound.Volume = 1
	endSound.PlaybackSpeed = 1
	endSound.Looped = false
	endSound.RollOffMinDistance = 10
	endSound.RollOffMaxDistance = 100
	endSound.RollOffMode = Enum.RollOffMode.InverseTapered
	endSound.Parent = parent
	endSound:Play()

	Debris:AddItem(endSound, 5)

	local lights = {}
	local playingSounds = {}

	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("ParticleEmitter") then
			obj.Rate = 0

		elseif obj:IsA("Light") then
			obj.Enabled = true
			obj.Range = 20
			obj.Brightness = 5
			table.insert(lights, obj)

		elseif obj:IsA("Sound") and obj.Playing then
			table.insert(playingSounds, obj)
		end
	end

	task.wait(0.01)

	if not model.Parent then
		return
	end

	for _, light in ipairs(lights) do
		if light.Parent then
			TweenService:Create(
				light,
				TweenInfo.new(
					0.65,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.Out
				),
				{
					Range = 0,
					Brightness = 0
				}
			):Play()
		end
	end

	for _, sound in ipairs(playingSounds) do
		if sound.Parent then
			TweenService:Create(
				sound,
				TweenInfo.new(
					0.65,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.Out
				),
				{
					PlaybackSpeed = 0
				}
			):Play()
		end
	end

	task.wait(0.65)

	if model.Parent then
		for _, obj in ipairs(model:GetDescendants()) do
			if obj:IsA("Sound") then
				obj:Stop()

			elseif obj:IsA("Light") then
				obj.Enabled = false

			elseif obj:IsA("ParticleEmitter") then
				obj.Enabled = false
			end
		end

		model:Destroy()
	end
end

local function SpawnShocker(origin)
	local originPosition = origin:GetPivot().Position
	local direction = getCameraDirection(origin)

	local spawnPosition = originPosition + direction * 20

	local model = ShockerTemplate

	model.Parent = workspace

	local reverse = originPosition - spawnPosition
	local flatReverse = Vector3.new(
		reverse.X,
		0,
		reverse.Z
	)

	local facing

	if flatReverse.Magnitude < 0.001 then
		facing = Vector3.new(0, 0, -1)
	else
		facing = flatReverse.Unit
	end

	model:PivotTo(
		CFrame.lookAt(
			spawnPosition,
			spawnPosition + facing
		)
	)

	local base = model:WaitForChild("Base")

	base.Anchored = true
	base.CanCollide = false
	base.CanTouch = false
	base.CanQuery = false

	return model
end

local function HookShocker(model, target)
	local base = model:WaitForChild("Base")

	local playSound = base:WaitForChild("PlaySound")
	local horrorScream = base:WaitForChild("HORROR SCREAM 15")

	local oldBodyPosition = base:FindFirstChild("BodyPosition")

	if oldBodyPosition then
		oldBodyPosition:Destroy()
	end

	local oldAttack = base:FindFirstChild("ShockerAttack")

	if oldAttack then
		oldAttack:Destroy()
	end

	local attackSound = Instance.new("Sound")
	attackSound.Name = "ShockerAttack"
	attackSound.SoundId = flyinnggg.SoundId
	attackSound.Volume = 1
	attackSound.PlaybackSpeed = 1
	attackSound.Looped = false
	attackSound.RollOffMinDistance = 10
	attackSound.RollOffMaxDistance = 100
	attackSound.RollOffMode = Enum.RollOffMode.InverseTapered
	attackSound.Parent = base

	local currentPosition = model:GetPivot().Position

	local hitbox = Instance.new("Part")
	hitbox.Name = "ShockerHitbox"
	hitbox.Shape = Enum.PartType.Ball
	hitbox.Size = Vector3.new(6, 6, 6)
	hitbox.Transparency = 1
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.CanTouch = false
	hitbox.CanQuery = true
	hitbox.CFrame = CFrame.new(base.Position)
	hitbox.Parent = model

	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.FilterDescendantsInstances = {
		target
	}

	local reaction = tonumber(
		LiveModifiers:GetAttribute("ShockerReaction")
	)

	if not reaction or reaction <= 0 then
		reaction = 1
	end

	local reactionTime = 2 * reaction

	playSound.PlaybackSpeed = 0.7
	playSound:Play()

	local reactionTween = TweenService:Create(
		playSound,
		TweenInfo.new(
			reactionTime,
			Enum.EasingStyle.Linear
		),
		{
			PlaybackSpeed = 2
		}
	)

	reactionTween:Play()

	local elapsed = 0

	while elapsed < reactionTime do
		if not model.Parent or not target.Parent then
			reactionTween:Cancel()
			destroyHitbox(hitbox)

			if model.Parent then
				model:Destroy()
			end

			return
		end

		if target:GetAttribute("Hiding") == true
			and target:GetAttribute("EquippedCharm") == "Accursed" then

			reactionTween:Cancel()
			destroyHitbox(hitbox)

			model:Destroy()
			return
		end

		local dt = RunService.RenderStepped:Wait()
		elapsed += dt

		local targetPosition = target:GetPivot().Position
		local direction = getCameraDirection(target)

		local wantedPosition =
			targetPosition + direction * 20

		currentPosition = currentPosition:Lerp(
			wantedPosition,
			1 - math.exp(-5 * dt)
		)

		local difference =
			targetPosition - currentPosition

		local flatDifference = Vector3.new(
			difference.X,
			0,
			difference.Z
		)

		local facing

		if flatDifference.Magnitude < 0.001 then
			facing = Vector3.new(0, 0, -1)
		else
			facing = flatDifference.Unit
		end

		model:PivotTo(
			CFrame.lookAt(
				currentPosition,
				currentPosition + facing
			)
		)

		hitbox.CFrame = CFrame.new(base.Position)
	end

	playSound.PlaybackSpeed = 2

	if target:GetAttribute("Hiding") == true then
		destroyHitbox(hitbox)
		model:Destroy()
		return
	end

	if target:FindFirstChild("Crucifix") then
		destroyHitbox(hitbox)
		model:Destroy()
		return
	end

	local targetPosition = target:GetPivot().Position

	local difference =
		model:GetPivot().Position - targetPosition

	local flatDifference = Vector3.new(
		difference.X,
		0,
		difference.Z
	)

	local direction

	if flatDifference.Magnitude < 0.001 then
		direction = Vector3.new(0, 0, -1)
	else
		direction = flatDifference.Unit
	end

	local startPosition =
		targetPosition + direction * 20

	local endPosition =
		targetPosition - direction * 20

	local movement =
		endPosition - startPosition

	local flatMovement = Vector3.new(
		movement.X,
		0,
		movement.Z
	)

	local facing

	if flatMovement.Magnitude < 0.001 then
		facing = Vector3.new(0, 0, -1)
	else
		facing = flatMovement.Unit
	end

	model:PivotTo(
		CFrame.lookAt(
			startPosition,
			startPosition + facing
		)
	)

	hitbox.CFrame = CFrame.new(base.Position)

	local speedModifier = tonumber(
		LiveModifiers:GetAttribute("ShockerSpeed")
	)

	if not speedModifier or speedModifier <= 0 then
		speedModifier = 1
	end

	local attackTime = 1 / speedModifier

	attackSound.PlaybackSpeed = 1
	attackSound.TimePosition = 0
	attackSound:Play()

	TweenService:Create(
		attackSound,
		TweenInfo.new(
			attackTime,
			Enum.EasingStyle.Circular,
			Enum.EasingDirection.Out
		),
		{
			PlaybackSpeed = 0.7
		}
	):Play()

	horrorScream.Parent = SoundService
	horrorScream:Play()

	Debris:AddItem(
		horrorScream,
		math.max(
			horrorScream.TimeLength,
			1
		) + 5
	)

	local faces = base:FindFirstChild("Attachment")

	if faces then
		faces = faces:FindFirstChild("Faces")
	end

	if faces then
		for _, emitter in ipairs(faces:GetChildren()) do
			if emitter:IsA("ParticleEmitter") then
				emitter.Texture = "rbxassetid://16026109489"
				emitter.Size = NumberSequence.new(3)
			end
		end
	end

	local elapsedAttack = 0
	local hit = false

	while elapsedAttack < attackTime do
		if not model.Parent then
			destroyHitbox(hitbox)
			return
		end

		local dt = RunService.RenderStepped:Wait()
		elapsedAttack += dt

		local alpha = math.clamp(
			elapsedAttack / attackTime,
			0,
			1
		)

		local eased = TweenService:GetValue(
			alpha,
			Enum.EasingStyle.Circular,
			Enum.EasingDirection.In
		)

		local position =
			startPosition:Lerp(
				endPosition,
				eased
			)

		model:PivotTo(
			CFrame.lookAt(
				position,
				position + facing
			)
		)

		hitbox.CFrame = CFrame.new(base.Position)

		local parts = workspace:GetPartsInPart(
			hitbox,
			overlap
		)

		if #parts > 0 then
			hit = true
			break
		end
	end

	destroyHitbox(hitbox)

	if hit then
		local humanoid = target:FindFirstChildOfClass("Humanoid")

		if humanoid and humanoid.Health > 0 then
			humanoid:TakeDamage(25)
		end
	end

	EndShocker(
		model,
		base,
		nil
	)
end

Character = getCharacter()

local shocker = SpawnShocker(Character)

if shocker then
	task.spawn(function()
		HookShocker(
			shocker,
			Character
		)
	end)
end
