local shaking = false
local shakeThread


local function StartShake()
	if shaking then return end
	
	shaking = true

	shakeThread = task.spawn(function()
		while shaking do
			camShake:ShakeOnce(
				0.5, -- magnitude
				2,   -- roughness
				0.05, -- fade in
				0.8, -- fade out
				Vector3.new(0.05,0.05,0.05),
				Vector3.new(0.2,0.2,0.2)
			)

			task.wait(0.7)
		end
	end)
end


local function StopShake()
	shaking = false
end


