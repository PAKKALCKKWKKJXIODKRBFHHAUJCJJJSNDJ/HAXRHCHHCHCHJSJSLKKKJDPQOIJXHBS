local shaking = false
local shakeThread
local shakeMultiplier = 1

local function StartShake()
	if shaking then return end

	shaking = true

	shakeThread = task.spawn(function()
		while shaking do
			camShake:ShakeOnce(
				2 * shakeMultiplier,
				2,
				0.05,
				0.1,
				0,
				0.8 * shakeMultiplier
			)

			task.wait(0.2)
		end
	end)
end

local function StopShake()
	shaking = false
end

