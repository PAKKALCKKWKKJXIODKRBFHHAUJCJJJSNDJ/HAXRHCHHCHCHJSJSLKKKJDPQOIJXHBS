	color.Brightness = 0
	color.Contrast = 0
	color.Saturation = 0
	color.Parent = lighting

	camShake:ShakeOnce(
		7,
		2,
		0.05,
		0.4,
		0,
		1
	)

	local fade = TweenService:Create(
		color,
		TweenInfo.new(
			0.5,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			TintColor = Color3.fromRGB(255, 255, 255),
			Brightness = 0,
			Contrast = 0
		}
	)

	fade:Play()

	fade.Completed:Once(function()
		color:Destroy()
	end)
end

