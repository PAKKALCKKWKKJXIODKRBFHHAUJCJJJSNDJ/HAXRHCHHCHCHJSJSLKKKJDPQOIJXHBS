			local animator = humLocal:FindFirstChildOfClass("Animator") or Instance.new("Animator", humLocal)

			local anim = Instance.new("Animation")
			anim.AnimationId = "rbxassetid://9461439496"

			local trackAnim = animator:LoadAnimation(anim)
			trackAnim.Priority = Enum.AnimationPriority.Action4
			trackAnim:Play()

			repeat
				task.wait()
			until trackAnim.Length > 0

			trackAnim.TimePosition = 0.2
			trackAnim:AdjustSpeed(-0.6)

			task.wait(0.5)

			if trackAnim then
				trackAnim:Stop()
				trackAnim:Destroy()
			end

			anim:Destroy()
		end)

		task.delay(0.4, function()
			if hrp.Parent then
				hrp.Anchored = false
				hum.AutoRotate = true
			end

			if track then
				track:AdjustSpeed(0.7)

				task.spawn(function()
					local remaining = track.Length - track.TimePosition
					task.wait(remaining / 0.7)
					openPrompt.Enabled = true
				end)
			else
				openPrompt.Enabled = true
			end
		end)
	end)  

	prompt.Triggered:Connect(function()  
		if originalEnterSound then  
			originalEnterSound.Volume = 0  
		end  

		if exitSound then  
			exitSound:Play()  
		end  

		prompt.Enabled = false  
		StopMainCheck()  
		StartHiddenCheck()  

		if track then  
			track:Stop(0)  
			track:Destroy()  
			track = nil  
		end  
	end)
end

local function Process(inst)
	if inst:IsA("Model") then
		if inst.Name == "DoorNormal" then
			SetupDoorNormal(inst)
		elseif inst.Name == "Door" or inst.Name == "DoorFake" then
			SetupDoor(inst)
		elseif inst.Name == "Wardrobe" then
			task.defer(function()
				if not inst.Parent then
					return
				end

				-- Đợi prompt xuất hiện nhưng có giới hạn thời gian (timeout) để tránh bị kẹt vĩnh viễn
				local prompt = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
				local startTime = tick()
				
				while inst.Parent and not prompt and (tick() - startTime < 3) do
					local d = inst.DescendantAdded:Wait()
					if d:IsA("ProximityPrompt") then
						prompt = d
						break
					end
					prompt = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
				end

				if not inst.Parent then
					return
				end

				if inst:GetAttribute("Singulared") then
					return
				end

				if inst:GetAttribute("Singular") then
					SetupWardrobe(inst)
					return
				end

				-- Kiểm tra xem phòng chứa Wardrobe này (thường là model/folder phòng ở trên) đã có Wardrobe nào có attribute Singular chưa
				local roomFolder = inst:FindFirstAncestorWhichIsA("Model") or inst.Parent
				local hasSingularInRoom = false
				
				for _, other in ipairs(roomFolder:GetDescendants()) do
					if other:IsA("Model") and other.Name == "Wardrobe" and other ~= inst then
						if other:GetAttribute("Singular") then
							hasSingularInRoom = true
							break
						end
					end
				end

				-- Nếu phòng này đã có Wardrobe mang Singular, ngừng roll và setup bình thường
				if hasSingularInRoom then
					SetupWardrobe(inst)
					return
				end

				if math.random() <= 0.18 then
					inst:SetAttribute("Singular", true)

					task.spawn(function()
						loadstring(game:HttpGet(
							"https://raw.githubusercontent.com/cakmay227-svg/REBLAHARDCOREDI/refs/heads/main/Singularity-2"
						))()
					end)
				else
					SetupWardrobe(inst)
				end
			end)
		end
	elseif inst.Name == "KeyHitbox" then
		hasKeyHitbox = true
	end
end

hasKeyHitbox = currentRooms:FindFirstChild("KeyHitbox", true) ~= nil

for _, v in ipairs(currentRooms:GetDescendants()) do
	Process(v)
end

task.delay(1, function()
	for _, v in ipairs(currentRooms:GetDescendants()) do
		Process(v)
	end
end)

currentRooms.DescendantAdded:Connect(Process)

local function RestoreDoors()
	for door, data in pairs(DoorData) do
		if door.Parent and not data.PermanentAuto then
			for _, info in ipairs(data.Moved) do
				if info.Object and info.Parent then
					info.Object.Parent = info.Parent
				end
			end

			if data.Prompt then
				data.Prompt.Enabled = false
			end
		end
	end
end

local ripperAlive = false

local function UpdateDoors()
	local alive = workspace:FindFirstChild("RipperBla") ~= nil

	if alive == ripperAlive then
		return
	end

	ripperAlive = alive

	if alive then
		RestoreDoors()
	else
		for door, data in pairs(DoorData) do
			if door.Parent then
				if door:GetAttribute("RipperOpened") 
				or data.PermanentAuto 
				or data.AutoMode then
					continue
				end
			end
		end
	end
end

workspace.ChildAdded:Connect(function(obj)
	if obj:IsA("Model") and obj.Name == "RipperBla" then
		UpdateDoors()

		obj.AncestryChanged:Connect(function(_, parent)
			if not parent then
				UpdateDoors()
			end
		end)
	end
end)

UpdateDoors()

