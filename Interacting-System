local function SetupDoorNormal(obj)
	local door = obj:FindFirstChild("Door")
	if obj:IsA("Model") and obj.Name == "DoorNormal" and door and door:IsA("MeshPart") then
		
		-- Ẩn các phần Hidden và Hinge ở mô hình gốc
		for _, v in ipairs(obj:GetDescendants()) do
			if v:IsA("BasePart") and (v.Name == "Hidden" or v.Name == "Hinge") then
				v.CanCollide = false
				v.Transparency = 1
			end
		end

		local cloneModel = obj:Clone()
		cloneModel.Name = "DoorClone"
		cloneModel.Parent = obj.Parent

		local cloneDoor = cloneModel:FindFirstChild("Door")
		local knob = cloneModel:FindFirstChild("Knob", true)
		local hidden = cloneModel:FindFirstChild("Hidden", true)
		local hinge = cloneModel:FindFirstChild("Hinge", true)

		local openSound = cloneDoor and cloneDoor:FindFirstChild("Open")
		local hitSound = cloneDoor and cloneDoor:FindFirstChild("Hit")

		if cloneDoor and knob and knob:IsA("BasePart") then
			-- Thiết lập thuộc tính cho bản sao
			for _, v in ipairs(cloneModel:GetDescendants()) do
				if v:IsA("BasePart") then
					if v.Name == "Hidden" or v.Name == "Hinge" then
						v.CanCollide = false
						v.Transparency = 1
					else
						v.CanCollide = true
						v.Transparency = 0
					end
				end
			end

			local oldCF = cloneDoor.CFrame

			local function GetOpenCF()
				local openAngle = 90
				local char = LocalPlayer.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")

				if hrp then
					local relative = cloneDoor.CFrame:PointToObjectSpace(hrp.Position)
					if relative.Z > 0 then
						openAngle = -90
					end
				end

				if hinge and hinge:IsA("BasePart") then
					local offset = hinge.CFrame:ToObjectSpace(oldCF)
					return hinge.CFrame * CFrame.Angles(0, math.rad(openAngle), 0) * offset
				else
					return oldCF * CFrame.Angles(0, math.rad(openAngle), 0)
				end
			end

			local openPrompt = Instance.new("ProximityPrompt")
			openPrompt.Style = Enum.ProximityPromptStyle.Custom
			openPrompt.ActionText = "Open Door"
			openPrompt.ObjectText = "Door"
			openPrompt.MaxActivationDistance = 10
			openPrompt.RequiresLineOfSight = false
			openPrompt.Parent = knob

			local closePrompt = openPrompt:Clone()
			closePrompt.ActionText = "Close Door"
			closePrompt.Enabled = false
			closePrompt.Parent = knob

			openPrompt.Triggered:Connect(function()
				openPrompt.Enabled = false
				closePrompt.Enabled = true
				
				if openSound and openSound:IsA("Sound") then
					openSound:Play()
				end

				if hidden then
					hidden.Parent = cloneModel
				end

				TweenService:Create(
					cloneDoor,
					TweenInfo.new(1, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
					{ CFrame = GetOpenCF() }
				):Play()
			end)

			closePrompt.Triggered:Connect(function()
				closePrompt.Enabled = false
				
				if hitSound and hitSound:IsA("Sound") then
					hitSound:Play()
				end

				local tween = TweenService:Create(
					cloneDoor,
					TweenInfo.new(1, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
					{ CFrame = oldCF }
				)

				tween:Play()
				tween.Completed:Wait()

				if hidden then
					hidden.Parent = nil
				end

				openPrompt.Enabled = true
			end)

			-- Xóa Door thật
			door:Destroy()
		end
	end
end

local function SetupDoor(door)
	if not (door:IsA("Model") and door.Name == "Door") then return end

	-- Dùng GetDescendants để quét toàn bộ xem có KeyHitbox không, nếu có thì bỏ qua
	local hasHitbox = false
	for _, v in ipairs(door:GetDescendants()) do
		if v.Name == "KeyHitbox" then
			hasHitbox = true
			break
		end
	end
	if not hasHitbox and door.Parent then
		for _, v in ipairs(door.Parent:GetDescendants()) do
			if v.Name == "KeyHitbox" then
				hasHitbox = true
				break
			end
		end
	end
	if hasHitbox then
		return
	end

	local moved = {}
	local knob

	for _, obj in ipairs(door:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == "Knob" then
			knob = obj
		end

		if obj.Name:sub(1, 5) == "Func_"
		or obj.Name == "ClientOpen"
		or obj.Name == "Hidden"
		or obj.Name == "Collision" then
			table.insert(moved, {
				Object = obj,
				Parent = obj.Parent
			})
			obj.Parent = nil
		end
	end

	if #moved == 0 or not knob then
		return
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.ActionText = "Open Door"
	prompt.ObjectText = "Door"
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = knob

	prompt.Triggered:Connect(function()
		prompt:Destroy()

		local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local hum = char:WaitForChild("Humanoid")
		local hrp = char:WaitForChild("HumanoidRootPart")

		local cf, size = door:GetBoundingBox()
		local targetPos = cf.Position - cf.LookVector * (size.Z / 2 + 2)
		local targetCF = CFrame.lookAt(targetPos, cf.Position)

		hum.AutoRotate = false
		hrp.Anchored = true

		local tween = TweenService:Create(
			hrp,
			TweenInfo.new(0.7, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
			{ CFrame = targetCF }
		)

		tween:Play()
		tween.Completed:Wait()

		hrp.Anchored = false
		hum.AutoRotate = true

		for _, info in ipairs(moved) do
			if info.Object and info.Parent then
				info.Object.Parent = info.Parent
			end
		end
	end)
end


