local function SetupLockedDoor(door)
	if door:GetAttribute("LockedDoorScanned") then
		return
	end
	door:SetAttribute("LockedDoorScanned", true)

	local clone = door:Clone()
	clone.Name = "DoorClone"
	clone.Parent = door.Parent
	
	for _, v in ipairs(door:GetDescendants()) do
		if v:IsA("BasePart") then
			if v.Name ~= "Lock" and not v:FindFirstAncestor("Lock") then
				v.Transparency = 1
			end
		elseif v:IsA("SurfaceGui") and v.Name == "Sign" then
			v:Destroy()
		elseif v:IsA("Sound") then
			if v.Name ~= "Fall" and v.Name ~= "Unlock" then
				v.Volume = 0
			end
		end
	end
	
	for _, v in ipairs(clone:GetDescendants()) do
		if (v:IsA("BasePart") or v:IsA("MeshPart")) then
			if v.Name == "Lock" or v.Name == "Hidden" then
				v.Transparency = 1
			end

			if v.Name == "Lock" then
				for _, d in ipairs(v:GetDescendants()) do
					if d:IsA("BasePart") then
						d.Transparency = 1
					elseif d:IsA("ProximityPrompt") then
						d:Destroy()
					end
				end
			end
		end
	end
	
	local knob
	for _, v in ipairs(clone:GetDescendants()) do
		if v:IsA("BasePart") and v.Name == "Knob" then
			knob = v
			break
		end
	end
	
	local realPrompt
	task.spawn(function()
		while door.Parent and not realPrompt do
			for _, v in ipairs(door:GetDescendants()) do
				if v:IsA("ProximityPrompt") then
					realPrompt = v
					break
				end
			end

			if not realPrompt then
				task.wait()
			end
		end
	end)

	local cloneDoor, hinge
	for _, v in ipairs(clone:GetDescendants()) do
		if v:IsA("BasePart") or v:IsA("MeshPart") then
			if v.Name == "Door" then
				cloneDoor = v
			elseif v.Name == "Hinge" then
				hinge = v
			end
		end
	end

	if not cloneDoor then
		for _, v in ipairs(clone:GetDescendants()) do
			if v:IsA("Model") and v.Name == "Door" then
				cloneDoor = v:FindFirstChildWhichIsA("BasePart", true)
				break
			end
		end
	end

	if not cloneDoor then return end

	local openSound
	for _, v in ipairs(cloneDoor:GetDescendants()) do
		if v:IsA("Sound") and v.Name == "Open" then
			openSound = v
			break
		end
	end
	
	local bellSound
	for _, v in ipairs(cloneDoor:GetDescendants()) do
		if v:IsA("Sound") and v.Name == "Bell" then
			bellSound = v
			break
		end
	end
	
	task.spawn(function()
		local customPrompt

		while door.Parent do
			if realPrompt and realPrompt.Enabled == false and not customPrompt and knob and knob.Parent then
				customPrompt = Instance.new("ProximityPrompt")
				customPrompt.Style = Enum.ProximityPromptStyle.Custom
				customPrompt.ActionText = "Open Door"
				customPrompt.ObjectText = "Door"
				customPrompt.MaxActivationDistance = 10
				customPrompt.RequiresLineOfSight = false
				customPrompt.Parent = knob

				customPrompt.Triggered:Connect(function()
					customPrompt:Destroy()
					
					for _, v in ipairs(clone:GetDescendants()) do
						if v:IsA("BasePart") and v.Name == "Collision" then
							v.CanCollide = false
						end
					end

					local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
					local hum = char:WaitForChild("Humanoid")
					local hrp = char:WaitForChild("HumanoidRootPart")

					local cf, size = clone:GetBoundingBox()
					local targetPos = cf.Position - cf.LookVector * (size.Z / 2 + 2)
					local targetCF = CFrame.lookAt(targetPos, cf.Position)

					local oldCF = cloneDoor.CFrame

					local function GetOpenCF()
						local angle = 95
						local relative = cloneDoor.CFrame:PointToObjectSpace(hrp.Position)
						if relative.Z > 0 then
							angle = -95
						end

						if hinge and hinge:IsA("BasePart") then
							local offset = hinge.CFrame:ToObjectSpace(oldCF)
							return hinge.CFrame * CFrame.Angles(0, math.rad(angle), 0) * offset
						else
							return oldCF * CFrame.Angles(0, math.rad(angle), 0)
						end
					end

					hum.AutoRotate = false
					hrp.Anchored = true

					TweenService:Create(
						hrp,
						TweenInfo.new(0.7, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
						{CFrame = targetCF}
					):Play()

					task.delay(0.3, function()
						if not clone.Parent then
							return
						end
						
						if openSound then
							openSound:Play()
						end
						
						if bellSound then
							bellSound:Play()
						end

						TweenService:Create(
							cloneDoor,
							TweenInfo.new(1, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
							{CFrame = GetOpenCF()}
						):Play()
					end)

					task.delay(0.4, function()
						if hrp.Parent then
							hrp.Anchored = false
							hum.AutoRotate = true
						end
					end)
				end)
				
				break
			end

			task.wait(0.01)
		end
	end)
end

local function SetupDoor(door)
	if not (door:IsA("Model") and (door.Name == "Door" or door.Name == "DoorFake")) then return end
	if door:GetAttribute("DoorScanned") then return end
	door:SetAttribute("DoorScanned", true)

	local hasHitbox = false  
	for _, v in ipairs(door:GetDescendants()) do  
		if v.Name == "KeyHitbox" then  
			hasHitbox = true  
			break  
		end  
	end  
	if not hasHitbox and door.Parent then  
		for _, v in ipairs(door.Parent:GetDescendants()) do  
			if v.Name == "KeyHitbox" then  
				hasHitbox = true  
				break  
			end  
		end  
	end  
	if hasHitbox then
		SetupLockedDoor(door)
		return
	end

	if DoorData[door] then return end

	DoorData[door] = {
		Moved = {},
		Prompt = nil,
		AutoMode = false,
		PermanentAuto = false
	}

	local moved = DoorData[door].Moved

	task.spawn(function()
		local knob  

		while door.Parent and not knob do
			for _, obj in ipairs(door:GetDescendants()) do  
				if obj:IsA("BasePart") and obj.Name == "Knob" then  
					knob = obj  
					break  
				end  
			end
			if not knob then
				door.DescendantAdded:Wait()
			end
		end

		if not door.Parent or not knob then  
			return  
		end  

		for _, obj in ipairs(door:GetDescendants()) do  
			if obj.Name:sub(1, 5) == "Func_"  
			or obj.Name == "ClientOpen"  
			or obj.Name == "Hidden"  
			or obj.Name == "Collision" then  
				table.insert(moved, {  
					Object = obj,  
					Parent = obj.Parent  
				})  
				obj.Parent = nil  
			end  
		end  

		if #moved == 0 then  
			return  
		end  

		local prompt = Instance.new("ProximityPrompt")  
		prompt.Style = Enum.ProximityPromptStyle.Custom  
		prompt.ActionText = "Open Door"  
		prompt.ObjectText = "Door"  
		prompt.MaxActivationDistance = 7 
		prompt.RequiresLineOfSight = false  
		prompt.Parent = knob  

		DoorData[door].Prompt = prompt

		local autoOpen = false

		prompt.PromptShown:Connect(function()
			if autoOpen then
				return
			end

			if not workspace:FindFirstChild("RipperBla") then
				return
			end

			local room = tonumber(door.Parent.Name)
			if not room or room ~= LatestRoom.Value then
				return
			end

			autoOpen = true

			DoorData[door].AutoMode = true
			DoorData[door].PermanentAuto = true

			door:SetAttribute("RipperOpened", true)

			for _, info in ipairs(moved) do
				if info.Object and info.Parent then
					info.Object.Parent = info.Parent
				end
			end

			fireproximityprompt(prompt)
		end)

		prompt.Triggered:Connect(function()
			local room = tonumber(door.Parent.Name)
			if room and room == LatestRoom.Value then
				DoorData[door].AutoMode = true
				DoorData[door].PermanentAuto = true
			end

			prompt:Destroy()

			if workspace:FindFirstChild("RipperBla") then
				for _, info in ipairs(moved) do
					if info.Object and info.Parent then
						info.Object.Parent = info.Parent
					end
				end
				return
			end

			local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()  
			local hum = char:WaitForChild("Humanoid")  
			local hrp = char:WaitForChild("HumanoidRootPart")  

			local cf, size = door:GetBoundingBox()  
			local targetPos = cf.Position - cf.LookVector * (size.Z / 2 + 2)  
			local targetCF = CFrame.lookAt(targetPos, cf.Position)  

			hum.AutoRotate = false  
			hrp.Anchored = true  

			local tween = TweenService:Create(  
				hrp,  
				TweenInfo.new(0.7, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),  
				{ CFrame = targetCF }  
			)  

			tween:Play()

			task.delay(0.3, function()
				if not door.Parent then
					return
				end

				for _, info in ipairs(moved) do
					if info.Object and info.Parent then
						info.Object.Parent = info.Parent
					end
				end
			end)

			task.delay(0.4, function()
				if hrp.Parent then
					hrp.Anchored = false
					hum.AutoRotate = true
				end
			end)
		end)
	end)
end

local function SetupWardrobe(wardrobe)
	if not (wardrobe:IsA("Model") and wardrobe.Name == "Wardrobe") then return end  
	if wardrobe:GetAttribute("WardrobeScanned") then return end
	wardrobe:SetAttribute("WardrobeScanned", true)

	if wardrobe:GetAttribute("Singular") then
		return
	end

	local prompt  
	for _, v in ipairs(wardrobe:GetDescendants()) do  
		if v:IsA("ProximityPrompt") then  
			prompt = v
			break  
		end  
	end  

	if not prompt then return end

prompt.ActionText = "Njkx" 

	prompt.Enabled = false  
	prompt.HoldDuration = 0.5  

	local openPrompt = prompt:Clone()  
	openPrompt.Parent = prompt.Parent  
	openPrompt.Enabled = true  
	openPrompt.HoldDuration = 0.5  
	openPrompt.ActionText = "Hide"  

	local closePrompt = openPrompt:Clone()  
	closePrompt.Parent = prompt.Parent  
	closePrompt.Enabled = false  
	closePrompt.ActionText = "Close"  

	local originalEnterSound, enterSound, exitSound

	for _, v in ipairs(wardrobe:GetDescendants()) do
		if v:IsA("Sound") then
			if v.Name == "SoundEnter" then
				originalEnterSound = v

				enterSound = Instance.new("Sound", wardrobe) 
				enterSound.Name = "SoundEnterClone"
				enterSound.RollOffMaxDistance = 30
				enterSound.Volume = 0.7
				enterSound.SoundId = GetGitSound(
					"https://github.com/cakmay227-svg/random/raw/refs/heads/main/open.mp3?raw=true",
					"opendadoor", 
					workspace
				).SoundId

				enterSound.Parent = v.Parent

			elseif v.Name == "SoundExit" then
				exitSound = v:Clone()
				exitSound.Name = "SoundExitClone"
				exitSound.RollOffMaxDistance = 30
				exitSound.Volume = 0.7
				exitSound.SoundId = GetGitSound(
					"https://github.com/cakmay227-svg/random/raw/refs/heads/main/close.mp3?raw=true",
					"closedadoor", 
					workspace
				).SoundId

				exitSound.Parent = v.Parent
			end
		end
	end

	local track  
	local main = wardrobe:FindFirstChild("Main", true)  
	local hiddenValue = wardrobe:FindFirstChild("HiddenPlayer", true)  

	local checkingMain = false  
	local checkingHidden = false  

	local function IsTouchingMain()  
		if not main then return false end  
		local char = LocalPlayer.Character  
		if not char then return false end  

		for _, part in ipairs(main:GetTouchingParts()) do  
			if part:IsDescendantOf(char) then  
				return true  
			end  
		end  
		return false  
	end  

	local function StartMainCheck()  
		if checkingMain then return end  
		checkingMain = true  

		task.spawn(function()  
			while checkingMain do  
				if closePrompt.Enabled then  
					if IsTouchingMain() then  
						closePrompt.Enabled = false  
						prompt.Enabled = true  
					else  
						prompt.Enabled = false  
						closePrompt.Enabled = true  
					end  
				end  
				task.wait(0.3)  
			end  
			checkingMain = false  
		end)  
	end  

	local function StopMainCheck()  
		checkingMain = false  
		prompt.Enabled = false  
	end  

	local function StopHiddenCheck()  
		checkingHidden = false  
	end  

	local function StartHiddenCheck()  
		if checkingHidden or not hiddenValue then return end  
		checkingHidden = true  

		task.spawn(function()  
			while checkingHidden do  
				local value = hiddenValue.Value  
				if value == LocalPlayer.Name then  
					openPrompt.Enabled = false  
					closePrompt.Enabled = false  
				else  
					checkingHidden = false  
					openPrompt.Enabled = true  
					closePrompt.Enabled = false  
					prompt.Enabled = false  
					break  
				end  
				task.wait(0.3)  
			end  
			checkingHidden = false  
		end)  
	end  

	local function PlayWardrobeAnimation()  
		local controller = wardrobe:FindFirstChildOfClass("AnimationController")  
		if not controller then  
			controller = Instance.new("AnimationController")  
			controller.Parent = wardrobe  
		end  

		local animator = controller:FindFirstChildOfClass("Animator")  
		if not animator then  
			animator = Instance.new("Animator")  
			animator.Parent = controller  
		end  

		local anim = Instance.new("Animation")  
		anim.AnimationId = "rbxassetid://9451146136"  

		if track then  
			track:Stop(0)  
			track:Destroy()  
			track = nil  
		end  

		track = animator:LoadAnimation(anim)  
		track:Play()  
		track:AdjustSpeed(0.8)  

		task.spawn(function()  
			repeat task.wait() until track.Length > 0  
			task.wait(track.Length / 2)  
			if track and track.IsPlaying then  
				track:AdjustSpeed(0)  
			end  
		end)  
	end  

	openPrompt.Triggered:Connect(function()  
		openPrompt.Enabled = false  
		local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()  
		local hum = char:WaitForChild("Humanoid")  
		local hrp = char:WaitForChild("HumanoidRootPart")  

		local cf, size = wardrobe:GetBoundingBox()  
		local targetPos = cf.Position + cf.LookVector * (size.Z / 2 + 2)  
		local targetCF = CFrame.lookAt(targetPos, cf.Position)  

		hum.AutoRotate = false  
		hrp.Anchored = true  

		local tween = TweenService:Create(  
			hrp,  
			TweenInfo.new(0.7, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),  
			{ CFrame = targetCF }  
		)  

		tween:Play()

		task.delay(0.3, function()
			if enterSound then
				enterSound:Play()
			end
			
			local player = Players.LocalPlayer
			local charLocal = player.Character or player.CharacterAdded:Wait()

			local humLocal = charLocal:WaitForChild("Humanoid")
			local animator = humLocal:FindFirstChildOfClass("Animator") or Instance.new("Animator", humLocal)

			local anim = Instance.new("Animation")
			anim.AnimationId = "rbxassetid://9461439496"

			local trackAnim = animator:LoadAnimation(anim)
			trackAnim.Priority = Enum.AnimationPriority.Action4
			trackAnim:Play()
			trackAnim:AdjustSpeed(0.6)

			task.spawn(function() 
				task.wait(0.5)
				if trackAnim then
					trackAnim:Stop()
					trackAnim:Destroy()
				end
				anim:Destroy()
			end) 

			closePrompt.Enabled = true
			StartMainCheck()
		end)

		task.delay(0.4, function()
			if hrp.Parent then
				hrp.Anchored = false
				hum.AutoRotate = true
			end

			PlayWardrobeAnimation()
		end)
	end)  

