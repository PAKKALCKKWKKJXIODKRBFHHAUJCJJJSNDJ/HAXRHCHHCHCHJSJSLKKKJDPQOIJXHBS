local function SetupWardrobe(wardrobe)
if not (wardrobe:IsA("Model") and wardrobe.Name == "Wardrobe") then return end
if wardrobe:GetAttribute("Singulared") then
	return
end

	if wardrobe:GetAttribute("Singular") then
	return
end

	local prompt
	for _, v in ipairs(wardrobe:GetDescendants()) do
		if v:IsA("ProximityPrompt") then
			prompt = v
			break
		end
	end

	if not prompt then return end

	prompt.Enabled = false
	prompt.HoldDuration = 0.5

	local openPrompt = prompt:Clone()
	openPrompt.Parent = prompt.Parent
	openPrompt.Enabled = true
	openPrompt.HoldDuration = 0.5
	openPrompt.ActionText = "Open"

	local closePrompt = openPrompt:Clone()
	closePrompt.Parent = prompt.Parent
	closePrompt.Enabled = false
	closePrompt.ActionText = "Close"

	local originalEnterSound, enterSound, exitSound
	for _, v in ipairs(wardrobe:GetDescendants()) do
		if v:IsA("Sound") then
			if v.Name == "SoundEnter" then
				originalEnterSound = v
				enterSound = v:Clone()
				enterSound.Name = "SoundEnterClone"
				enterSound.Parent = v.Parent
			elseif v.Name == "SoundExit" then
				exitSound = v:Clone()
				exitSound.Name = "SoundExitClone"
				exitSound.Parent = v.Parent
			end
		end
	end

	local track
	local main = wardrobe:FindFirstChild("Main", true)
	local hiddenValue = wardrobe:FindFirstChild("HiddenPlayer", true)

	local checkingMain = false
	local checkingHidden = false

	local function IsTouchingMain()
		if not main then return false end
		local char = LocalPlayer.Character
		if not char then return false end

		for _, part in ipairs(main:GetTouchingParts()) do
			if part:IsDescendantOf(char) then
				return true
			end
		end
		return false
	end

	local function StartMainCheck()
		if checkingMain then return end
		checkingMain = true

		task.spawn(function()
			while checkingMain do
				if closePrompt.Enabled then
					if IsTouchingMain() then
						closePrompt.Enabled = false
						prompt.Enabled = true
					else
						prompt.Enabled = false
						closePrompt.Enabled = true
					end
				end
				task.wait(0.3)
			end
			checkingMain = false
		end)
	end

	local function StopMainCheck()
		checkingMain = false
		prompt.Enabled = false
	end

	local function StopHiddenCheck()
		checkingHidden = false
	end

	local function StartHiddenCheck()
		if checkingHidden or not hiddenValue then return end
		checkingHidden = true

		task.spawn(function()
			while checkingHidden do
				local value = hiddenValue.Value
				if value == LocalPlayer.Name then
					openPrompt.Enabled = false
					closePrompt.Enabled = false
				else
					checkingHidden = false
					openPrompt.Enabled = true
					closePrompt.Enabled = false
					prompt.Enabled = false
					break
				end
				task.wait(0.3)
			end
			checkingHidden = false
		end)
	end

	local function PlayWardrobeAnimation()
		local controller = wardrobe:FindFirstChildOfClass("AnimationController")
		if not controller then
			controller = Instance.new("AnimationController")
			controller.Parent = wardrobe
		end

		local animator = controller:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = controller
		end

		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://9451146136"

		if track then
			track:Stop(0)
			track:Destroy()
			track = nil
		end

		track = animator:LoadAnimation(anim)
		track:Play()
		track:AdjustSpeed(0.8)

		task.spawn(function()
			repeat task.wait() until track.Length > 0
			task.wait(track.Length / 2)
			if track and track.IsPlaying then
				track:AdjustSpeed(0)
			end
		end)
	end

	openPrompt.Triggered:Connect(function()
		openPrompt.Enabled = false
		local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local hum = char:WaitForChild("Humanoid")
		local hrp = char:WaitForChild("HumanoidRootPart")

		local cf, size = wardrobe:GetBoundingBox()
		local targetPos = cf.Position + cf.LookVector * (size.Z / 2 + 2)
		local targetCF = CFrame.lookAt(targetPos, cf.Position)

		hum.AutoRotate = false
		hrp.Anchored = true

		local tween = TweenService:Create(
			hrp,
			TweenInfo.new(0.7, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
			{ CFrame = targetCF }
		)

		tween:Play()
		tween.Completed:Wait()

		if enterSound then
			enterSound:Play()
		end

		closePrompt.Enabled = true
		StartMainCheck()

		hrp.Anchored = false
		hum.AutoRotate = true

		PlayWardrobeAnimation()
	end)

	closePrompt.Triggered:Connect(function()
		StopMainCheck()
		StopHiddenCheck()

		closePrompt.Enabled = false
		local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local hum = char:WaitForChild("Humanoid")
		local hrp = char:WaitForChild("HumanoidRootPart")

		local cf, size = wardrobe:GetBoundingBox()
		local targetPos = cf.Position + cf.LookVector * (size.Z / 2 + 2)
		local targetCF = CFrame.lookAt(targetPos, cf.Position)

		hum.AutoRotate = false
		hrp.Anchored = true

		local tween = TweenService:Create(
			hrp,
			TweenInfo.new(0.7, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
			{ CFrame = targetCF }
		)

		tween:Play()
		tween.Completed:Wait()

		if exitSound then
			exitSound:Play()
		end

		hrp.Anchored = false
		hum.AutoRotate = true

		if track then
			track:AdjustSpeed(0.7)
			task.spawn(function()
				local remaining = track.Length - track.TimePosition
				task.wait(remaining / 0.7)
				openPrompt.Enabled = true
			end)
		else
			openPrompt.Enabled = true
		end
	end)

	prompt.Triggered:Connect(function()
		if originalEnterSound then
			originalEnterSound.Volume = 0
		end

		if exitSound then
			exitSound:Play()
		end

		prompt.Enabled = false
		StopMainCheck()
		StartHiddenCheck()

		if track then
			track:Stop(0)
			track:Destroy()
			track = nil
		end
	end)
end

local function Process(inst)
	if inst:IsA("Model") then
		
		if inst.Name == "DoorNormal" then
			SetupDoorNormal(inst)

		elseif inst.Name == "Door" then
			SetupDoor(inst)

		elseif inst.Name == "Wardrobe" then
			
			task.defer(function()
				task.wait(0.2)

				if not inst.Parent then
					return
				end

				if inst:GetAttribute("Singulared") then
					return
				end

				if inst:GetAttribute("Singular") then
					SetupWardrobe(inst)
					return
				end

				local roll = math.random()

				if roll <= 0.3 then
					inst:SetAttribute("Singular", true)

					task.spawn(function()
						loadstring(game:HttpGet(
							"https://raw.githubusercontent.com/cakmay227-svg/REBLAHARDCOREDI/refs/heads/main/Singularity-2"
						))()
					end)
				else
					SetupWardrobe(inst)
				end
			end)

		elseif inst.Name == "Bed" then
			SetupBed(inst)
		end

	elseif inst.Name == "KeyHitbox" then
		hasKeyHitbox = true
	end
end



