		if v:IsA("BasePart") and not (v.Transparency == 1 and v.CanCollide) then

			for _, face in ipairs(Enum.NormalId:GetEnumItems()) do
				local tex = Instance.new("Texture")
				tex.Texture = id
				tex.Face = face
				tex.StudsPerTileU = 2
				tex.StudsPerTileV = 2
				tex.Rotation = rots[math.random(#rots)]
				tex.Parent = v

				table.insert(textures, tex)
			end

			-- Gắn SurfaceGui của m ở đây nếu cần
			-- local gui = ...
			-- gui.Parent = v
			-- table.insert(surfaceGuis, gui)

		end
	end

	rotationThread = task.spawn(function()
		while enabled do
			task.wait(1)

			for i = #textures, 1, -1 do
				local tex = textures[i]

				if tex.Parent then
					tex.Rotation = rots[math.random(#rots)]
				else
					table.remove(textures, i)
				end
			end
		end
	end)
end

function BloodRoom.Disable()
	if not enabled then
		return
	end

	enabled = false

	for _, tex in ipairs(textures) do
		if tex.Parent then
			tex:Destroy()
		end
	end

	table.clear(textures)

	for _, gui in ipairs(surfaceGuis) do
		if gui.Parent then
			gui:Destroy()
		end
	end

	table.clear(surfaceGuis)
end


