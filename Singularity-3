-- Quét liên tục lọc các DoorNormal thỏa mãn điều kiện
while true do
	local validDoorNormals = {}
	
	for _, v in ipairs(room:GetDescendants()) do
		if v:IsA("Model") and v.Name == "DoorNormal" then
			local doorPart = v:FindFirstChild("Hidden")
			if doorPart and doorPart:IsA("BasePart") then
				if testmode then
					-- Testmode: Bỏ qua mọi điều kiện attribute, chỉ cần là DoorNormal có phần Hidden
					table.insert(validDoorNormals, v)
				else
					-- Chế độ thường: Chấp nhận nếu CÓ attribute "Singular" VÀ KHÔNG CÓ attribute "Singulared"
					local hasSingular = v:GetAttribute("Singular")
					local hasSingulared = v:GetAttribute("Singulared")
					
					if hasSingular and (not hasSingulared) then
						table.insert(validDoorNormals, v)
					end
				end
			end
		end
	end
	
	if #validDoorNormals == 0 then
		s:Destroy()
		return
	end
	
	-- Random chọn 1 model trong danh sách hợp lệ
	local randomDoorNormal = validDoorNormals[math.random(1, #validDoorNormals)]
	local doorPart = randomDoorNormal:FindFirstChild("Hidden")
	
	if doorPart and doorPart:IsA("BasePart") then
		-- Đánh dấu đã dùng qua để không bị chọn lại
		randomDoorNormal:SetAttribute("Singulared", true)
		selectedDoorNormal = randomDoorNormal
		
		-- Lấy CFrame và LookVector của Hidden Part
		local doorCFrame = doorPart.CFrame
		local doorPos = doorCFrame.Position
		local doorLook = doorCFrame.LookVector

		-- Spawn entity cùng độ cao với Hidden, lùi lại đằng sau và quay hướng cùng LookVector
		local spawnPosition = doorPos - (doorLook * -4.7)
		local spawnCFrame = CFrame.new(spawnPosition.X, doorPos.Y, spawnPosition.Z) * CFrame.lookAt(Vector3.zero, doorLook)

		if entity:IsA("Model") then
			entity:PivotTo(spawnCFrame)
		else
			entity.CFrame = spawnCFrame
		end
		
		break
	end
end


