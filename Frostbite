local function IsNearWarmSource(character)
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    local filterList = {character}
    local entityModel = workspace:FindFirstChild("Frostyma5n")
    if entityModel then table.insert(filterList, entityModel) end
    overlapParams.FilterDescendantsInstances = filterList

    local nearbyParts = workspace:GetPartBoundsInRadius(root.Position, 18, overlapParams)
    for _, part in ipairs(nearbyParts) do
        if part:IsDescendantOf(entityModel) then continue end
        local pName = part.Name:lower()
        if pName:find("fireplace") or pName:find("heater") then
            return true
        end
        local parent = part.Parent
        if parent then
            local parentName = parent.Name:lower()
            if parentName:find("fireplace") or parentName:find("heater") then
                return true
            end
        end
    end

    if isEntityActive then
        for _, lightObj in ipairs(activeCyanLights) do
            if lightObj and lightObj.Parent then
                local pos = lightObj:IsA("Model") and lightObj:GetPivot().Position or lightObj.Position
                if (root.Position - pos).Magnitude <= 18 then
                    return true
                end
            end
        end
    end

    return false
end

local attackWaves = math.random(5, 7)
local phase2StartWave

if attackWaves == 5 then
    phase2StartWave = 4
elseif attackWaves == 6 then
    if math.random(1, 100) <= 45 then
        phase2StartWave = 5
    else
        phase2StartWave = 4
    end
elseif attackWaves == 7 then
    if math.random(1, 100) <= 25 then
        phase2StartWave = 6
    else
        phase2StartWave = 5
    end
end

local isPhase2 = false

local coldGui, coldContainer, fillBar = CreateColdBarUI()
local currentColdValue = 1.0 

for i = 1, attackWaves do
    if i >= phase2StartWave and not isPhase2 then
        isPhase2 = true
        
        if Phase1Sound then
            Phase1Sound:Stop()
        end
        if Phase2Sound then
            Phase2Sound.Parent = workspace
            Phase2Sound.Volume = 6
            Phase2Sound.PlaybackSpeed = 1
            Phase2Sound.Looped = true
            Phase2Sound.Name = "FrostymanPhase2"
            Phase2Sound:Play()
        end
    end

    local roomToProcess = GetPreviousRoom()
    local currentRoom = GetCurrentHighestRoom()
    
    if not currentRoom then break end

    local frost4 = Lighting:FindFirstChild("frost4")
    if frost4 then
        TweenService:Create(frost4, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), HALF_FROST):Play()
    end

    if roomToProcess then
        ProcessRandomLight(roomToProcess)
    end

    if i > 1 then
        task.wait(1.5)
    end

    local camera = workspace.CurrentCamera
    local s = modelTemplate:Clone()
    s.Parent = workspace
    s.Name = "Frostyma5n"

    -- Configure all BaseParts and special elements inside the model
    for _, desc in ipairs(s:GetDescendants()) do
        if desc:IsA("BasePart") then
            desc.Anchored = true
            desc.CanCollide = false
        elseif desc:IsA("ParticleEmitter") then
            if desc.Name == "E2" then
                desc.Shape = Enum.ParticleEmitterShape.Sphere
            end
            desc.Enabled = true
        elseif desc:IsA("Fire") then
            desc.Enabled = true
        elseif desc:IsA("Sound") then
            desc:Play()
        end
    end

    EnsurePrimary(s)

    local entity = s:FindFirstChild("RushNew") or s:FindFirstChildWhichIsA("BasePart") or s.PrimaryPart or s:FindFirstChild("FrostyNew")
    if not entity then 
        s:Destroy() 
        break 
    end

    local entrance = currentRoom:FindFirstChild("RoomEntrance")
    local exit = currentRoom:FindFirstChild("RoomExit")
    local targetCFrame

    if entrance and exit then
        local pos = (entrance.Position + exit.Position) / 2
        targetCFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    elseif entrance then
        targetCFrame = entrance.CFrame * CFrame.new(0, 3, -15)
    end

    if targetCFrame then
        s:PivotTo(targetCFrame)
    end

    if frost4 then
        TweenService:Create(frost4, TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), FULL_FROST):Play()
    end

    local attachment = entity:FindFirstChild("Attachment")
    if attachment then
        for _, v in ipairs(attachment:GetDescendants()) do
            if v:IsA("ParticleEmitter") then v.Enabled = false end
        end
    end

    task.wait(0.5)

    local attacking = true

    task.spawn(function()
        pcall(function()
            local CameraShaker = require(ReplicatedStorage:WaitForChild("CameraShaker", 2))
