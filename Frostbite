local function GetGitSound(GithubSnd, SoundName)
    local fileName = SoundName .. ".mp3"
    if not isfile(fileName) then
        local success, response = pcall(function() return game:HttpGet(GithubSnd) end)
        if success and response then
            writefile(fileName, response)
        else
            warn("[Frostbite]: KhÃ´ng thá»ƒ táº£i Ã¢m thanh: " .. SoundName)
            return nil
        end
    end
    local sound = Instance.new("Sound")
    sound.SoundId = getasset(fileName)
    return sound
end

local function GetGithubModel(url, fileName)
    if not isfile(fileName) then
        local response = http_request({
            Url = url,
            Method = "GET"
        })

        if response and response.StatusCode == 200 then
            writefile(fileName, response.Body)
        else
            warn("[Frostbite]: KhÃ´ng thá»ƒ táº£i Model tá»« GitHub!")
            return nil
        end
    end

    local success, result = pcall(function()
        return game:GetObjects(getcustomasset(fileName))[1]
    end)

    return success and result or nil
end

